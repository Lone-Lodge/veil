use veil
use os

fn main() -> int:
    print_line("Veil — pure Orion")
    print_line("version: " + version())

    rect = Rect{x: 0, y: 0, width: 100, height: 50}
    inside = rect_contains(rect, Point{x: 25, y: 25})
    outside = rect_contains(rect, Point{x: 200, y: 200})
    print_line("rect contains (25,25): " + show_bool(inside))
    print_line("rect contains (200,200): " + show_bool(outside))

    doc = empty_doc()
    theme = empty_theme()
    display = resolve(doc, theme)
    mut count = 0
    for _cmd in display.commands:
        count = count + 1
    print_line("draw commands from empty doc: " + show_int(count))

    # Web smoke: theme + inventory + showcase wired through veil_web.
    web_theme = default_theme()
    inv = demo_inventory()
    moved = move_selection(inv, 2)
    print_line("inventory selection: " + show_int(moved.selected_index))
    print_line("button scene root nodes: " + show_int(scene_nodes(button_scene())))
    json = render(empty_doc(), web_theme)
    print_line("render json: " + json)

    # Full pipeline on a NON-empty doc: resolve a button (bg + label) and
    # hit-test it against the same layout. A button emits 2 commands
    # (DrawRect + DrawText); (30,30) lands inside it, (700,500) misses.
    btn = button_scene()
    dt = default_theme()
    mut dc = 0
    for _c in resolve(btn, dt).commands:
        dc = dc + 1
    print_line("button scene draw commands (expect 2): " + show_int(dc))
    print_line("pick at (30,30) (expect node 0): " + show_int(pick_node(btn, dt, 30, 30)))
    print_line("pick at (700,500) is miss (expect true): " + show_bool(pick_node(btn, dt, 700, 500) < 0))
    0

fn scene_nodes(doc: SemanticDocument) -> int:
    mut count = 0
    for _node in doc.nodes:
        count = count + 1
    count

fn show_bool(b: bool) -> Text:
    if b:
        "true"
    else:
        "false"

fn show_int(value: int) -> Text:
    if value == 0:
        "0"
    else:
        digits(value)

fn digits(value: int) -> Text:
    if value == 0:
        ""
    else:
        digits(value / 10) + glyph(value - (value / 10) * 10)

fn glyph(d: int) -> Text:
    if d == 0 then "0" else if d == 1 then "1" else if d == 2 then "2" else if d == 3 then "3" else if d == 4 then "4" else if d == 5 then "5" else if d == 6 then "6" else if d == 7 then "7" else if d == 8 then "8" else "9"
