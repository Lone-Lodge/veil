use veil
use os

fn main() -> int:
    print_line("Veil — pure Orion")
    print_line("version: " + version())

    rect = Rect{x: 0, y: 0, width: 100, height: 50}
    inside = rect_contains(rect, Point{x: 25, y: 25})
    outside = rect_contains(rect, Point{x: 200, y: 200})
    print_line("rect contains (25,25): " + show_bool(inside))
    print_line("rect contains (200,200): " + show_bool(outside))

    doc = empty_doc()
    theme = empty_theme()
    display = resolve(doc, theme)
    mut count = 0
    for _cmd in display.commands:
        count = count + 1
    print_line("draw commands from empty doc: " + show_int(count))

    # Web smoke: theme + inventory + showcase wired through veil_web.
    web_theme = default_theme()
    inv = demo_inventory()
    moved = move_selection(inv, 2)
    print_line("inventory selection: " + show_int(moved.selected_index))
    print_line("button scene root nodes: " + show_int(scene_nodes(button_scene())))
    json = render(empty_doc(), web_theme)
    print_line("render json: " + json)

    # Full pipeline on a NON-empty doc: resolve a button (bg + label) and
    # hit-test it against the same layout. A button emits 2 commands
    # (DrawRect + DrawText); (30,30) lands inside it, (700,500) misses.
    btn = button_scene()
    dt = default_theme()
    mut dc = 0
    for _c in resolve(btn, dt).commands:
        dc = dc + 1
    print_line("button scene draw commands (expect 2): " + show_int(dc))
    print_line("pick at (30,30) (expect node 0): " + show_int(pick_node(btn, dt, 30, 30)))
    print_line("pick at (700,500) is miss (expect true): " + show_bool(pick_node(btn, dt, 700, 500) < 0))

    # Reactive signals: a write marks the store dirty; clear resets it.
    a = signal_int(empty_store(), 10)
    print_line("signal initial (expect 10): " + show_int(signal_get(a.store, a.id)))
    print_line("dirty after alloc (expect true): " + show_bool(any_dirty(a.store)))
    cleared = clear_dirty(a.store)
    print_line("dirty after clear (expect false): " + show_bool(any_dirty(cleared)))
    written = signal_set(cleared, a.id, 42)
    print_line("signal after set (expect 42): " + show_int(signal_get(written, a.id)))
    print_line("dirty after set (expect true): " + show_bool(any_dirty(written)))

    # classify covers every interaction kind.
    print_line("classify mouse_up (expect release): " + itag(classify("mouse_up", 5, 6)))
    print_line("classify scroll (expect scroll): " + itag(classify("scroll", 7, 0)))
    print_line("classify key_down (expect key): " + itag(classify("key_down", 65, 0)))
    print_line("classify mouse_down (expect press): " + itag(classify("mouse_down", 5, 6)))
    # Payloads land in the documented axis: scroll delta and key code both
    # ride `x` (parallel scalar events); a pointer press keeps (x,y).
    print_line("scroll delta (expect 7): " + show_int(iscalar(classify("scroll", 7, 0))))
    print_line("key code (expect 65): " + show_int(iscalar(classify("key_down", 65, 0))))

    # Tree resolver: a panel with 3 heading children — headings indent under
    # it. 5 commands (panel rect+text + 3 heading texts); a pick at the
    # indented child column lands on heading node 1.
    st = stack_scene()
    print_line("stack scene draw commands (expect 5): " + show_int(cmd_count(resolve(st, dt))))
    print_line("pick indented child at (35,90) (expect node 1): " + show_int(pick_node(st, dt, 35, 90)))
    0

fn cmd_count(list: DisplayList) -> int:
    mut c = 0
    for _cmd in list.commands:
        c = c + 1
    c

fn itag(i: Interaction) -> Text:
    match i:
        PressAt(_, _) -> "press"
        ReleaseAt(_, _) -> "release"
        KeyPress(_) -> "key"
        Scroll(_) -> "scroll"

# The scalar payload of a non-pointer intent (key code / scroll delta),
# or the x pixel of a pointer one — the axis classify documents for `x`.
fn iscalar(i: Interaction) -> int:
    match i:
        PressAt(x, _) -> x
        ReleaseAt(x, _) -> x
        KeyPress(k) -> k
        Scroll(d) -> d

fn scene_nodes(doc: SemanticDocument) -> int:
    mut count = 0
    for _node in doc.nodes:
        count = count + 1
    count

fn show_bool(b: bool) -> Text:
    if b:
        "true"
    else:
        "false"

fn show_int(value: int) -> Text:
    if value == 0:
        "0"
    else:
        digits(value)

fn digits(value: int) -> Text:
    if value == 0:
        ""
    else:
        digits(value / 10) + glyph(value - (value / 10) * 10)

fn glyph(d: int) -> Text:
    if d == 0 then "0" else if d == 1 then "1" else if d == 2 then "2" else if d == 3 then "3" else if d == 4 then "4" else if d == 5 then "5" else if d == 6 then "6" else if d == 7 then "7" else if d == 8 then "8" else "9"
