# veil_resolver - document × theme → display list.
#
# Deterministic, explainable, inspectable: layout() exposes the
# measured rect per node, and resolve/pick_node both consume that
# single truth - the pixel you see and the pixel you hit-test come
# from the same pass.


# The text a node presents, whichever prop carries it.

use veil_document
use veil_theme
use veil_role
use veil_measure
use veil_motion
use ori_display
use ori_geometry
use typeface
use text

public define node_text(node: Node) -> text:
    edit found = ""
    loop prop in node.props:
        if prop.key is "label":
            found = prop.content
        if prop.key is "text":
            found = prop.content
        if prop.key is "body":
            found = prop.content
    found

# A node's raw prop value for a key ("" if absent). Flex attributes
# (align, later justify/grow/fill) ride as props until the model carries them
# as fields - the interim carrier the fold uses (ARCHITECTURE.md step 5b).
# The most-called function in the whole framework: a screen of 161 boxes
# asks it nineteen thousand times, a hundred and nineteen per box. It used
# to keep scanning after it had the answer, so every one of those walked the
# node's whole property list. First match wins now - a document never writes
# the same key twice, and the helpers that build them cannot.
define prop_val(node: Node, key: text) -> text:
    edit found = ""
    loop prop in node.props:
        if prop.key is key:
            found = prop.content
            break
    found

# `show: 0` hides a node AND collapses it - no size, no place, no
# paint, no click, no gap where it stood. Absent or non-zero shows.
# The host writes the 0/1; the resolver only obeys it.
public define node_shown(node: Node) -> truth:
    prop_val(node, "show") is not "0"

# The type size a node asks for: its own `size:` prop, else the role's, else
# the 13px body default. Measure and DrawText read the SAME number, so text
# is never wider than its box thinks.
# --- how big a design unit is ----------------------------------------------
# The document is written in units and the screen decides how many pixels
# one of them is. 100 is one to one. A dense display, or a reader who
# wants everything a size larger, moves this ONE number and the whole
# interface moves with it - padding, gaps, corners, borders, text, icons
# and the boxes themselves. There is nothing per-widget to adjust and no
# second set of numbers to keep in step.
#
# Ratios are not lengths and are left alone: `grow: 2` is still twice as
# much as `grow: 1`, and `w: 40%` is still forty per cent, at any scale.
public define set_scale(percent: number) -> number:
    slot_set("veil:scale", if percent < 50 then 50 else if percent > 400 then 400 else percent)

# Read once per length, and every length in the document goes through it -
# a screen asks a couple of thousand times. Asking `slot_has` first only to
# ask again hashed the same key twice; a scale of zero is not a scale, so
# zero is how "nobody set one" says itself.
public define scale_now() -> number:
    s = slot_get_number("veil:scale")
    if s is 0 then 100 else s

# A length in design units, in pixels. Rounded rather than truncated, so a
# 1px hairline at 150% is 2px and not 1.
# A length in design units, in pixels, AT a scale. Rounded rather than
# truncated, so a 1px hairline at 150% is 2px and not 1.
#
# The scale used to be read from the store inside here, which meant one
# lookup per length in the document - three thousand eight hundred of them
# for a screen of a hundred and sixty boxes, and half of that screen's
# layout time. It is read once where a node is worked on and carried down.
define big(v: number, at_scale: number) -> number:
    if at_scale is 100 then v else (v * at_scale + 50) // 100

define node_size(node: Node, style: StyleRule, at_scale: number) -> number:
    dflt = if style.size > 0 then style.size else 13
    big(prop_int(node, "size", dflt), at_scale)

# Corner rounding, the same way round: the node's own, else the role's.
define node_radius(node: Node, style: StyleRule, at_scale: number) -> number:
    big(prop_int(node, "radius", style.radius), at_scale)

# `radius: "8"` is all four corners; `radius: "8 8 0 0"` is top-left,
# top-right, bottom-right, bottom-left. A tab is round on top and square on
# the bottom, and so is every joined button group - one number for all four
# cannot say it. Scaled per corner like every other length.
# A corner is whole pixels, and it goes out as TEXT so one command can
# carry four of them. Saying `to_whole` is not decoration: a `number` is a
# real, and a real written into text is "10.000000" here and "10" natively -
# and the reader on the other side takes every digit it sees, so a corner of
# ten came back as ten million and every panel was a lozenge.
define node_corners(node: Node, style: StyleRule, less: number, at_scale: number) -> text:
    v = prop_val(node, "radius")
    if v is "":
        return "{to_whole(cut_at(big(style.radius, at_scale), less))}"
    parts = split(v, " ")
    if length(parts) < 4:
        return "{to_whole(cut_at(big(number_in(v), at_scale), less))}"
    "{to_whole(cut_at(big(number_in(parts[0]), at_scale), less))} {to_whole(cut_at(big(number_in(parts[1]), at_scale), less))} {to_whole(cut_at(big(number_in(parts[2]), at_scale), less))} {to_whole(cut_at(big(number_in(parts[3]), at_scale), less))}"

# The corner of the fill inside a border is the outer corner minus the
# border, or the border would show a fat ring at every corner and a thin
# one along every edge.
define cut_at(v: number, less: number) -> number:
    if v > less then v - less else 0

# Border width and its colour, node prop first like everything else.
define node_border(node: Node, style: StyleRule, at_scale: number) -> number:
    big(prop_int(node, "border", style.border), at_scale)

define node_border_colour(node: Node, style: StyleRule) -> text:
    c = prop_val(node, "edge")
    if length(c) > 0 then c else style.border_colour

# `wrap: 1` lets a run of text break across lines instead of running off
# the edge. Off by default: a label that silently became two lines tall
# would push everything under it down without saying why.
# The width a child has to work with: this node's own inner width, else
# what came down from above, else nothing to promise.
define inner_room(own: number, avail: number, pad: number) -> number:
    if own > 0:
        return own - pad * 2
    if avail > 0:
        return avail - pad * 2
    0

# A wrapping leaf claims the whole width it was offered - that is what
# wrapping means. One that does not wrap is as wide as its line.
define leaf_wide(own: number, wrapped: truth, box: number, line: number) -> number:
    if own > 0:
        return own
    if wrapped:
        return box
    line

# `clip: 1` cuts this node's children to its box. Anything longer than the
# box - a list, a line of typing - stops shoving its neighbours aside and
# is simply not drawn past the edge.
# `layer: N` lifts a node and its subtree above everything with a lower
# layer, wherever it sits in the tree. A dialog belongs to the thing that
# opened it, not to the top of the document, and without this it would be
# painted where it happens to live and disappear under its neighbours.
#
# Paint walks the tree once per layer, low to high. Picking walks it the
# other way, so the raised thing answers first - a dialog that draws over
# the page but lets its clicks through would be worse than no dialog.
define node_layer(node: Node) -> number:
    prop_int(node, "layer", 0)

define node_clips(node: Node) -> truth:
    prop_val(node, "clip") is "1"

# How far the contents are shifted, in pixels. Scrolling IS clipping plus an
# offset; keeping them one idea means a scrolled thing is always a clipped
# thing and cannot be forgotten.
# A pixel count, or the word `end`: keep the far edge of the contents
# against the far edge of the box. That is what a single-line input wants -
# you type, and what you just typed stays visible - and it needs no help
# from the app, which would otherwise have to measure the text itself.
# A scroll offset on its way to where the app just put it. Named nodes
# only - the name is the identity across frames, and a node without one
# is built from nothing every frame anyway, so it has no past to move
# from. Placement, the content extent and the scrollbar thumb all read
# through here, so all three agree on where the list currently is.
define glide(node: Node, what: text, target: number) -> number:
    who = node_name(node)
    if who is "":
        return target
    smooth("{who}|{what}", target)

# Put a scrolling box exactly where you say. A page showing something new
# should BE at the top, not slide there from where the last page was.
public define scroll_snap(name: text, at_y: number) -> number:
    motion_set("{name}|sy", big(at_y, scale_now()))

public define scroll_snap_x(name: text, at_x: number) -> number:
    motion_set("{name}|sx", big(at_x, scale_now()))

define node_scroll_x(node: Node) -> number:
    glide(node, "sx", big(prop_int(node, "scroll_x", 0), scale_now()))

define scrolls_to_end(node: Node) -> truth:
    prop_val(node, "scroll_x") is "end"

define node_scroll_y(node: Node) -> number:
    glide(node, "sy", big(prop_int(node, "scroll_y", 0), scale_now()))

# `scrollbar: 1` on a clipping node draws the track and thumb itself, out
# of the same rects the scrolling uses. Scroll that leaves no mark is
# scroll nobody finds: there is nothing on screen to say the list goes on,
# or how far down it you are.
define node_bars(node: Node) -> truth:
    prop_val(node, "scrollbar") is "1"

# A box that SCROLLS is saying its contents are bigger than it is. Asking
# for the height of everything in it is then exactly the wrong answer: its
# parent believed nothing would fit and squeezed the whole screen to make
# room - the header, the tab bar and every panel, by a ratio that changed
# with whichever page happened to be open. A scrolling box asks for
# nothing and takes what it is given, which is what scrolling MEANS.
define node_rolls(node: Node) -> truth:
    node_bars(node) or given(node, "scroll_y") or prop_val(node, "scroll_x") is "end"

# How tall the contents are. The children have already been SHIFTED up by
# the scroll when they were placed, so their measured bottom is where they
# sit now, not how much there is. Adding the scroll back gives the real
# extent - without it the content appeared to shrink as you scrolled, and
# the thumb shot off the end of its track.
define content_below(doc: SemanticDocument, measured: [Measured], node_id: number, box: Rect) -> number:
    node = doc.nodes[node_id]
    # A lazy list knows its own length: what is in it is a dozen rows out of
    # twenty-four thousand, and measuring those would say the list is a dozen
    # rows long - the thumb would fill the whole track and scrolling would
    # stop at the twelfth row.
    if lists_lazily(node):
        said = row_height(node)
        # A grid stacks its rows, not its items: ten thousand slots four
        # across is two thousand five hundred rows tall.
        across = node_grid(node)
        lines = if across > 1 then (rows_total(node) + across - 1) // across else rows_total(node)
        if said > 0:
            return lines * said
        # Not said, so it is the average of the rows that are here.
        edit tall = 0
        edit many = 0
        loop k in node.children:
            if node_shown(doc.nodes[k]):
                tall = tall + to_whole(measured[k].rect.high)
                many = many + 1
        if many is 0:
            return 0
        return lines * (tall // many)
    edit low = to_whole(box.y)
    loop k in node.children:
        if node_shown(doc.nodes[k]):
            r = measured[k].rect
            bottom = to_whole(r.y + r.high)
            if bottom > low:
                low = bottom
    low - to_whole(box.y) + node_scroll_y(node)

# --- a list that only has the rows you can see ------------------------------
#
# Twenty-four thousand rows of which twelve exist. The box says how many
# there ARE and how tall one is, and hands over only the ones in view along
# with the index the first of them has:
#
#     win = row_window(24000, 26, 150, at)
#     n("well", [p("rows", "24000"), p("row_h", "26"), p("from", "{win.first}"),
#                p("h", "150"), p("clip", "1"), p("scrollbar", "1"),
#                p("scroll_y", "{at}")], the_twelve)
#
# veil puts the first one where its index says it belongs and reports the
# whole list's height, so the scroll offset and the scrollbar tell the truth
# about a list that is mostly not there. The app builds twelve nodes, veil
# measures twelve, places twelve and draws twelve.
#
# Rows have to be equally tall - that is the whole of what buys this. A list
# of things that are each a different height is measured one by one like
# anything else, and that is still the honest answer for a chat log.
define rows_total(node: Node) -> number:
    prop_int(node, "rows", 0)

define row_height(node: Node) -> number:
    big(prop_int(node, "row_h", 0), scale_now())

define lists_lazily(node: Node) -> truth:
    rows_total(node) > 0

define first_row(node: Node) -> number:
    prop_int(node, "from", 0)

define node_wraps(node: Node) -> truth:
    prop_val(node, "wrap") is "1"

define node_shadow_colour(node: Node, style: StyleRule) -> text:
    c = prop_val(node, "shade")
    if length(c) > 0 then c else style.shadow_colour

define inset(r: Rect, by: number) -> Rect:
    d = to_real(by)
    Rect{x: r.x + d, y: r.y + d, wide: r.wide - d * 2.0, high: r.high - d * 2.0}

# One filled box, rounded or not.
# Parts per thousand turned into the pixels of THIS box.
define in_box(poly: text, r: Rect) -> text:
    edit out = ""
    loop pair in split(poly, " "):
        bits = split(pair, ",")
        if length(bits) is 2:
            px = to_whole(r.x + r.wide * to_real(number_in(bits[0])) / 1000.0)
            py = to_whole(r.y + r.high * to_real(number_in(bits[1])) / 1000.0)
            out = if out is "" then "{to_whole(px)},{to_whole(py)}" else "{out} {to_whole(px)},{to_whole(py)}"
    out

define push_box(list: DisplayList, r: Rect, colour: text, corners: text, src: number) -> DisplayList:
    if corners is not "0" then push_cmd(list, DrawRoundRect(r, colour, corners, src))
    else push_cmd(list, DrawRect(r, colour, src))

# Cross-axis alignment as a per-mille factor of the leftover extent:
# start = flush (0), center = half (500), end = far edge (1000).
define align_factor(a: text) -> number:
    if a is "center" then 500 else if a is "end" then 1000 else 0

# Parse a non-negative number from a prop string (digit bytes only).
# The whole number written in a text, ignoring everything that is not a
# digit. A document says its numbers in text, and so does an app reading
# back the `do:` names it wrote - one reading for both.
public define number_in(t: text) -> number:
    b = bytes_of(t)
    n = bytes_count(b)
    edit acc = 0
    loop i in 0 until n:
        c = byte_at(b, i)
        if c >= 48 and c <= 57:
            acc = acc * 10 + (c - 48)
    acc

# A size given as a share of the parent: `w: "40%"`. The document says what
# fraction of the room it wants and the layout works out the pixels, which
# is the only way a bar can be certain never to burst its own track. -1
# when the value is not a percentage.
define prop_percent(node: Node, key: text) -> number:
    v = prop_val(node, key)
    b = bytes_of(v)
    n = bytes_count(b)
    if n < 2 or byte_at(b, n - 1) is not 37:
        return 0 - 1
    number_in(v)

# A size the document stated, read ONCE. Asking whether it was said, then
# whether it is a per-cent, then what the number is, walked the property
# list three times over - and measuring did that for `w` AND for `h` on
# every node, so eight walks answered two questions.
public type Said: spoke: truth, share: truth, amount: number

define said(node: Node, key: text) -> Said:
    v = prop_val(node, key)
    if length(v) is 0:
        return Said{spoke: false, share: false, amount: 0}
    bs = bytes_of(v)
    bn = bytes_count(bs)
    Said{spoke: true, share: bn >= 2 and byte_at(bs, bn - 1) is 37, amount: number_in(v)}

define prop_int(node: Node, key: text, dflt: number) -> number:
    v = prop_val(node, key)
    if length(v) is 0 then dflt else number_in(v)

# Whether the document said anything at all about this. `h: 0` and no `h`
# are different things: one is a box with no height, the other is a box
# that sizes to what is in it. Without this a section could not collapse,
# because asking for nothing gave you everything.
# `trim: 1` - cut with a full stop rather than run over.
# Painted, but transparent to the pointer.
define node_passes(node: Node) -> truth:
    prop_val(node, "pass") is "1"

# `off: 1` - here, visible, and not taking part. A disabled control that
# still answers the pointer is worse than no control: it looks like it
# did nothing when you pressed it. It is drawn in its role's `:off` look,
# it cannot be picked, and nothing inside it can either.
define node_off(node: Node) -> truth:
    prop_val(node, "off") is "1"

# `margin: N` - room OUTSIDE the box. Padding is room inside, and a gap
# belongs to the row rather than to any one thing in it; a margin is the
# one a thing carries with it wherever it is put.
define node_margin(node: Node, at_scale: number) -> number:
    big(prop_int(node, "margin", 0), at_scale)

# `aspect: "16:9"` - one side worked out from the other. A thumbnail, a
# video, a map tile and a card image all keep their shape at any width,
# and saying so with two numbers beats recomputing a height by hand
# everywhere the width can change.
define aspect_of(node: Node) -> number:
    v = prop_val(node, "aspect")
    if v is "":
        return 0
    parts = split(v, ":")
    if length(parts) < 2:
        return 0
    w = number_in(parts[0])
    h = number_in(parts[1])
    if w <= 0 or h <= 0 then 0 else w * 1000 // h

define node_trims(node: Node) -> truth:
    prop_val(node, "trim") is "1"

# `min_w`/`max_w`/`min_h`/`max_h`. "At least this and at most that" is the
# commonest thing a real screen says about a box, and until now it could
# only say one exact number or a share of its parent.
define bounded(node: Node, which: text, v: number, at_scale: number) -> number:
    least = big(prop_int(node, "min_{which}", 0), at_scale)
    most = big(prop_int(node, "max_{which}", 0), at_scale)
    held = if v < least then least else v
    if most > 0 and held > most then most else held

# Did this child NAME its size along the way its parent runs? A per-cent
# is a share of the parent, which is a preference; a number is a statement.
define said_main(kid: Node, row: truth) -> truth:
    it = said(kid, if row then "w" else "h")
    it.spoke and not it.share

define given(node: Node, key: text) -> truth:
    length(prop_val(node, key)) > 0

# What a node is called. `id` when it says so, else the name it answers to
# when clicked - a thing that already has a name does not need a second
# one. This is identity ACROSS frames: the tree is rebuilt every frame, so
# an index means nothing, and a node with no name has no past to move
# from. `id` is separate from `do` because giving a slider's fill a `do`
# to make it glide would also make it swallow the click meant for the
# slider.
define node_name(node: Node) -> text:
    n = prop_val(node, "id")
    if n is not "" then n else prop_val(node, "do")

# `ease: 1` - this box's size travels to whatever the document last said
# it should be, rather than arriving there at once. What makes a section
# fold, a drawer slide and a tree branch open instead of blink.
define node_eases(node: Node) -> truth:
    prop_val(node, "ease") is "1" and node_name(node) is not ""

# The rule for a node: its role, in whatever state the node says it is in.
# One place, so paint, measure, place and pick can never disagree about
# what a node looks like.
define style_of(theme: Theme, node: Node) -> StyleRule:
    lookup_state(theme, node.role, if node_off(node) then "off" else prop_val(node, "state"))

# Every node's rule is worked out once, in measure_all, and read from an
# array after that. Measuring, placing and painting each used to look it
# up for themselves, so a screen of 151 nodes scanned the theme 453 times
# to arrive at 151 answers. An empty array means there is none yet - the
# one-off measure_in path, which has no pass to hang a cache on.
define ready_style(theme: Theme, node: Node, node_id: number, styles: [StyleRule]) -> StyleRule:
    if length(styles) is 0:
        return style_of(theme, node)
    styles[node_id]

define is_row(style: StyleRule) -> truth:
    style.direction is "row"

# --- per-node style: a node prop overrides the role's theme StyleRule --------
# This is what unifies the two theme models: Veil-web drives style per-ROLE
# (theme), Atlas drives it per-ENTITY (props on the widget). The resolver reads
# props first, falling back to the theme - so ONE resolver serves both.
define node_pad(node: Node, style: StyleRule, at_scale: number) -> number:
    big(prop_int(node, "pad", style.padding), at_scale)

define node_gap(node: Node, style: StyleRule, at_scale: number) -> number:
    big(prop_int(node, "gap", style.gap), at_scale)

# How a box arranges its children, read ONCE.
#
# Whether it is a row, whether it stacks, whether it flows and how many
# columns it has are four questions about the same word, and both passes
# asked all four - so `layout` was the second most-read property on the
# screen, eleven hundred times for a hundred and sixty-one boxes.
public type Arranged: row: truth, stacked: truth, flows: truth, cols: number

define arranging(node: Node, style: StyleRule) -> Arranged:
    l = prop_val(node, "layout")
    if length(l) is 0:
        return Arranged{row: style.direction is "row", stacked: false, flows: false, cols: 0}
    Arranged{row: l is "row" or l is "horizontal", stacked: l is "stack", flows: l is "flow", cols: if l is "grid" then prop_int(node, "cols", 1) else 0}

define node_row(node: Node, style: StyleRule) -> truth:
    l = prop_val(node, "layout")
    if length(l) > 0 then l is "row" or l is "horizontal" else style.direction is "row"

# `layout: stack` puts every child in the SAME box instead of in a line.
# Without it two things cannot occupy one space, and a dialog has nowhere
# to be: flow would put it politely below the page it is meant to cover.
# Stack is what `layer` needs to be useful, and layer is what makes stack
# come out in the right order.
define node_stacks(node: Node) -> truth:
    prop_val(node, "layout") is "stack"

# `layout: grid` with `cols: N` lays children out in N equal columns,
# wrapping to a new row every N. A table, a calendar, a palette of swatches
# - anything where the columns line up down the page, which flow cannot do
# because flow only knows about one axis at a time.
define node_grid(node: Node) -> number:
    if prop_val(node, "layout") is "grid" then prop_int(node, "cols", 1) else 0

# `layout: flow` is a row that carries on to the next line when it runs
# out of width, each line as tall as the tallest thing on it. It is the
# one arrangement a responsive screen cannot do without: a toolbar, a
# chip list or a row of cards has to become two rows on a narrow window
# or at a large scale, and shrinking everything until the words are cut
# is not the same answer.
define node_flows(node: Node) -> truth:
    prop_val(node, "layout") is "flow"

# How wide and how tall a flow comes out, given the width it has. Returns
# the height; the width is whatever it was given.
define flow_high(doc: SemanticDocument, theme: Theme, face: Font, node: Node, room: number, gap: number, done: [Size2], wraps: [number], styles: [StyleRule], kid_w: number) -> number:
    edit line_w = 0
    edit line_h = 0
    edit total = 0
    edit any = false
    loop c in node.children:
        if node_shown(doc.nodes[c]):
            cs = kid_size(doc, theme, face, c, kid_w, done, wraps, styles)
            step = if line_w is 0 then cs.w else line_w + gap + cs.w
            if line_w > 0 and step > room:
                total = total + line_h + gap
                line_w = cs.w
                line_h = cs.h
            else:
                line_w = step
                line_h = if cs.h > line_h then cs.h else line_h
            any = true
    if any then total + line_h else 0

# How tall a grid of `n` children in `cols` columns is, given the tallest
# child. Rows are uniform: a grid whose rows each found their own height
# would not line up across, which is the whole reason to use one.
# Every cell in a grid is as tall as the tallest child, so the rows line up.
define tallest_kid(doc: SemanticDocument, theme: Theme, face: Font, node: Node, room: number) -> number:
    edit tall = 0
    loop k in node.children:
        if node_shown(doc.nodes[k]):
            h = measure_in(doc, theme, face, k, room).h
            if h > tall:
                tall = h
    tall

define grid_high(n: number, cols: number, cell_h: number, gap: number) -> number:
    rows = (n + cols - 1) // cols
    if rows <= 0 then 0 else rows * cell_h + (rows - 1) * gap

# Box fill colour: `color:` prop (Atlas, already token-resolved to a literal by
# the adapter) else the theme's bg. Label colour: `ink:` prop else theme fg.
define node_bg(node: Node, style: StyleRule) -> text:
    c = prop_val(node, "color")
    if length(c) > 0 then c else style.bg_colour

define node_fg(node: Node, style: StyleRule) -> text:
    c = prop_val(node, "ink")
    if length(c) > 0 then c else style.fg_colour

# A node's intrinsic content size (bottom-up). Explicit `w:`/`h:` props override.
type Size2: w: number, h: number

# --- pass 1: intrinsic sizing ---
# A leaf sizes to its text + padding. A container sizes to the sum of its
# children along the main axis (+ gaps) and the max along the cross axis, + its
# own padding. Explicit `w`/`h` props win.
public define measure(doc: SemanticDocument, theme: Theme, face: Font, node_id: number) -> Size2:
    measure_in(doc, theme, face, node_id, 0)

# Measuring against an available WIDTH, because wrapping text has no
# intrinsic size - it is as tall as the room it is given is narrow. `fill`
# and `grow` hand out width during placement, which is after measurement,
# so the width has to come down from the parent that already knows it.
# 0 means unconstrained: measure as one long line.
public define measure_in(doc: SemanticDocument, theme: Theme, face: Font, node_id: number, avail_w: number) -> Size2:
    measure_deep(doc, theme, face, node_id, avail_w, [], [], [])

# The same measurement, but able to read sizes already worked out for the
# children. `done`/`wraps` empty means there are none and everything below
# is measured for real - which is what a re-measure against a new width
# has to do anyway.
define measure_deep(doc: SemanticDocument, theme: Theme, face: Font, node_id: number, avail_w: number, done: [Size2], wraps: [number], styles: [StyleRule]) -> Size2:
    if node_shown(doc.nodes[node_id]):
        measure_shown(doc, theme, face, node_id, avail_w, done, wraps, styles)
    else:
        Size2{w: 0, h: 0}

# A child's size: the one already worked out, unless nothing below it has
# been done yet, or its subtree wraps and so has no size until it is told
# a width.
define kid_size(doc: SemanticDocument, theme: Theme, face: Font, k: number, avail_w: number, done: [Size2], wraps: [number], styles: [StyleRule]) -> Size2:
    if length(done) is 0 or wraps[k] is 1:
        return measure_deep(doc, theme, face, k, avail_w, done, wraps, styles)
    done[k]

define measure_shown(doc: SemanticDocument, theme: Theme, face: Font, node_id: number, avail_w: number, done: [Size2], wraps: [number], styles: [StyleRule]) -> Size2:
    node = doc.nodes[node_id]
    style = ready_style(theme, node, node_id, styles)
    # Read ONCE for this node and carried into every length below. It used
    # to be read inside `big`, so a screen of a hundred and sixty boxes did
    # it three thousand eight hundred times - half its layout.
    at_scale = scale_now()
    pad = node_pad(node, style, at_scale)
    gap = node_gap(node, style, at_scale)
    # A percentage is not an intrinsic size - it is a claim on the parent,
    # settled during placement. Measuring it as if it were a pixel count
    # would have `40%` mean forty pixels.
    w_said = said(node, "w")
    h_said = said(node, "h")
    ew = if w_said.share then 0 else big(w_said.amount, at_scale)
    eh = if h_said.share then 0 else big(h_said.amount, at_scale)
    said_w = w_said.spoke and not w_said.share
    said_h = h_said.spoke and not h_said.share
    words = node_text(node)
    ink_size = node_size(node, style, at_scale)
    wrapping = node_wraps(node)
    ts = text_size(words, ink_size, face)
    if length(node.children) is 0:
        # A wrapping leaf is as tall as the lines it breaks into. Wrapping
        # needs a width to break against, so it only happens when the node
        # was given one - `wrap: 1` without a `w:` has nothing to wrap to.
        # The box to wrap against: this node's own width if it was given
        # one, else whatever the parent says is available.
        box = if ew > 0 then ew else avail_w
        room = box - pad * 2
        wrapped = wrapping and room > 0
        wh = if wrapped then wrapped_high(words, ink_size, face, room) else ts.high
        # A wrapping leaf claims the whole width it was offered; that is
        # what wrapping MEANS, and reporting its one-line width would let a
        # parent size itself as if the text never broke.
        # A wrapping leaf is as wide as its longest word, not its whole
        # line. What width it ends up with is its parent's business, and
        # claiming the unbroken line made every ancestor size itself for a
        # width nobody was going to hand out.
        least = if wrapping then widest_word(words, ink_size, face) + pad * 2 else ts.wide + pad * 2
        # A trimmed leaf asks for no more than it was offered: it will cut
        # itself to fit rather than push its row wider.
        cw = leaf_wide(ew, wrapped, box, least)
        held_w = if node_trims(node) and avail_w > 0 and cw > avail_w then avail_w else cw
        leaf_w = bounded(node, "w", held_w, at_scale)
        leaf_h = bounded(node, "h", if said_h then eh else wh + pad * 2, at_scale)
        leaf_shape = aspect_of(node)
        Size2{w: leaf_w, h: if leaf_shape > 0 and leaf_w > 0 then leaf_w * 1000 // leaf_shape else leaf_h}
    else:
        how = arranging(node, style)
        row = how.row
        stacked = how.stacked
        cols = how.cols
        flows = how.flows
        edit main = 0
        edit cross = 0
        edit tallest = 0
        edit shown_n = 0
        # What a child has to work with across the box. For a column that
        # is the inner width outright; for a row it is an upper bound,
        # which is the honest answer before the main axis is shared out.
        kid_w = inner_room(ew, avail_w, pad)
        edit i = 0
        loop c in node.children:
            if node_shown(doc.nodes[c]):
                raw_kid = kid_size(doc, theme, face, c, kid_w, done, wraps, styles)
                # The room a child carries with it is room the PARENT has
                # to find. Counted only when the line was walked and not
                # when it was measured, the parent came out too small and
                # squeezed everything to fit what it had not counted.
                spare = node_margin(doc.nodes[c], at_scale) * 2
                cs = Size2{w: raw_kid.w + spare, h: raw_kid.h + spare}
                cm = if row then cs.w else cs.h
                cc = if row then cs.h else cs.w
                if cs.h > tallest:
                    tallest = cs.h
                shown_n = shown_n + 1
                if stacked:
                    # Everything shares the box, so the box is the biggest
                    # of them rather than the sum.
                    if cm > main:
                        main = cm
                else:
                    if i > 0:
                        main = main + gap
                    main = main + cm
                if cc > cross:
                    cross = cc
                i = i + 1
        cw = if row then main else cross
        ch = if row then cross else main
        # A grid is as tall as its rows, whatever the flow arithmetic said.
        asks_nothing = node_rolls(node)
        gh = grid_high(shown_n, if cols > 0 then cols else 1, tallest, gap)
        # A flow is as tall as the lines it breaks into, which depends on
        # the width it is given - the same shape of answer wrapping text
        # has, for the same reason.
        room = inner_room(ew, avail_w, pad)
        fh = if flows and room > 0 then flow_high(doc, theme, face, node, room, gap, done, wraps, styles, kid_w) else ch
        used_h = if cols > 0 then gh else if flows then fh else ch
        own_w = bounded(node, "w", if said_w then ew else if asks_nothing then 0 else cw + pad * 2, at_scale)
        own_h = bounded(node, "h", if said_h then eh else if asks_nothing then 0 else used_h + pad * 2, at_scale)
        shape = aspect_of(node)
        Size2{w: own_w, h: if shape > 0 and own_w > 0 then own_w * 1000 // shape else own_h}

# Children in `order:` order (default 0, stable on ties). Selection sort - child
# counts are small.
define child_order(doc: SemanticDocument, node: Node) -> [number]:
    ids = node.children
    n = length(ids)
    # Almost nothing uses `order`, and the sort below is a selection sort
    # that rescans the taken list and re-reads a prop in its innermost
    # loop - cubic, with a props walk inside. A list of 24 rows paid about
    # fourteen thousand rounds of it, in the measure pass AND the placement
    # pass, to arrive at the order it was already in.
    edit any_order = false
    loop k in ids:
        if prop_int(doc.nodes[k], "order", 0) is not 0:
            any_order = true
    if not any_order:
        return ids
    # The orders are read ONCE, and "already taken" is a mark beside each
    # rather than a list to rescan. What is left is an honest selection sort:
    # a thousand nameplates sorted by depth is a million comparisons of two
    # numbers, not a million walks down a property list inside a scan of
    # everything taken so far.
    edit orders = []
    edit gone = []
    loop k in ids:
        orders = append(orders, prop_int(doc.nodes[k], "order", 0))
    loop _g in 0 until n:
        gone = append(gone, 0)
    edit out = []
    loop _p in 0 until n:
        edit best_i = 0 - 1
        edit best_o = 0
        loop i in 0 until n:
            if gone[i] is 0 and (best_i < 0 or orders[i] < best_o):
                best_i = i
                best_o = orders[i]
        gone = set(gone, best_i, 1)
        out = append(out, ids[best_i])
    out

# --- the size cache --------------------------------------------------------
# Measuring re-walks a node's whole subtree, and placement measures every
# child, so a node twelve deep was measured twelve times over. Sizes are
# computed ONCE here, bottom-up, and read from an array during placement.
#
# The one thing that cannot be cached is a subtree containing WRAPPING
# text: its height depends on the width its parent hands it, which is only
# known on the way down. Those are re-measured for real. A flag per node
# says whether its subtree contains any, so the exception costs a lookup
# rather than a walk.

# The sizes, and which subtrees are exactly what they were.
#
# `same` is 1 for a node whose properties, children and everything below it
# are unchanged AND whose size came out the same. Placing can then skip it
# whole: nothing below it can have moved. It is empty from a cold measure,
# because a frame told from nothing knows of no "before".
public type Sizes: box: [Size2], wraps: [number], styles: [StyleRule], same: [number]

define wraps_below(doc: SemanticDocument, node_id: number, out: [number]) -> truth:
    node = doc.nodes[node_id]
    # A flow has no height until it is told a width, exactly like a
    # paragraph. Measured without one it reported a single line, and then
    # broke into two when it was placed - so everything below it sat a
    # line too high and the row that wrapped was the wrong one.
    edit any = node_wraps(node) or node_flows(node)
    loop k in node.children:
        if out[k] is 1:
            any = true
    any

# One bottom-up pass, FORWARD through the array, and each node reads the
# sizes its children already have rather than re-walking them - which is
# what made this pass cost the sum of every subtree instead of the tree. A node has to be done
# after its children, and the builders' convention puts children at lower
# indices than the parents that name them - they append children first and
# the root last. Walking backwards meant every parent read flags its
# children had not set yet, so a column containing a wrapping paragraph
# was not marked as wrapping and used its unconstrained size. The layout
# came out faster and wrong.
public define measure_all(doc: SemanticDocument, theme: Theme, face: Font) -> Sizes:
    n = length(doc.nodes)
    # Three lists grown in ONE loop is three quadratics. `append` only grows
    # a list in place while that list is the last thing in the frame region,
    # and a Size2 or a StyleRule made between two appends puts something
    # after it - so every append copied all three lists, a hundred and sixty
    # times over. Each list is filled with ONE placeholder first, with
    # nothing allocating in between, and then written in place.
    zero = Size2{w: 0, h: 0}
    edit box = []
    loop i in 0 until n:
        box = append(box, zero)
    edit wraps = []
    loop i in 0 until n:
        wraps = append(wraps, 0)
    edit styles = []
    if n > 0:
        blank = style_of(theme, doc.nodes[0])
        loop i in 0 until n:
            styles = append(styles, blank)
    loop i in 0 until n:
        styles = set(styles, i, style_of(theme, doc.nodes[i]))
    loop i in 0 until n:
        wraps = set(wraps, i, if wraps_below(doc, i, wraps) then 1 else 0)
        box = set(box, i, measure_deep(doc, theme, face, i, 0, box, wraps, styles))
    Sizes{box: box, wraps: wraps, styles: styles, same: []}

# The size to use for a child: the cached one, unless something below it
# wraps and the width on offer is not the one it was measured against.
# The same size with its MAIN dimension replaced - which axis that is
# depends on the direction the box flows in.
define travelling(kid: Node, cs: Size2) -> Size2:
    if not node_eases(kid):
        return cs
    who = node_name(kid)
    Size2{w: smooth("{who}|w", cs.w), h: smooth("{who}|h", cs.h)}

define with_main(cs: Size2, row: truth, main: number) -> Size2:
    if row then Size2{w: main, h: cs.h} else Size2{w: cs.w, h: main}

define sized(doc: SemanticDocument, theme: Theme, face: Font, sizes: Sizes, k: number, avail_w: number) -> Size2:
    if sizes.wraps[k] is 1:
        # With the sizes handed along, only the chain down to the text that
        # actually breaks is walked again; everything beside it is already
        # known, and known correctly, because nothing in it depends on the
        # width. Without them, every ancestor of one paragraph re-measured
        # its whole subtree - the paragraph made the layout quadratic.
        return measure_deep(doc, theme, face, k, avail_w, sizes.box, sizes.wraps, sizes.styles)
    sizes.box[k]

# --- pass 2: placement with flex ---
# Place a node in its assigned box, then flow its children: `grow` expands
# children to fill leftover main space; else `justify` distributes it; `align`
# positions each child on the cross axis; `fill` stretches a child across it;
# `order` reorders. The full flex vocabulary Atlas's layout_container has, on the
# shared ori_display seam. (measure() is re-walked per child - fine for UI-sized
# trees; memoize if it ever matters.)
define place_nodes(doc: SemanticDocument, theme: Theme, face: Font, node_id: number, x: number, y: number, w: number, h: number, measured: [Measured]) -> [Measured]:
    place_sized(doc, theme, face, node_id, x, y, w, h, measured, measure_all(doc, theme, face))

# --- placed against something, not in the line ------------------------------
# A menu, a tooltip and the ghost under a dragged thing are not part of the
# row they appear over: they hang off something. Until now the gallery
# pushed its menu into place with two empty boxes the size of the pointer's
# position, which works and is a lie - the menu had no idea what it was
# attached to, so it could not stay attached, and it walked off the side of
# the screen because nothing knew where the screen ended.
#
#     at: "open_menu"   side: below     - under the thing with that name
#     at_x: 120  at_y: 340             - at that spot, and nowhere else
#
# Either way the node comes OUT of the flow: it takes no room in the line
# it is written in, and what is around it lays out as if it were not there.

define node_at(node: Node) -> text:
    prop_val(node, "at")

define floats(node: Node) -> truth:
    node_at(node) is not "" or given(node, "at_x") or given(node, "at_y")

# Where a floating node goes. `at` names something already placed; the side
# says which way off it, and the box it must stay inside decides whether
# that side is the one it gets - a menu that would hang off the bottom of
# the screen opens upwards instead, which is what every menu everywhere
# does and what nobody notices until it is missing.
define float_spot(doc: SemanticDocument, acc: [Measured], kid: Node, size: Size2, room: Rect) -> Point:
    to = node_at(kid)
    side = prop_val(kid, "side")
    at_scale = scale_now()
    edit x = to_real(big(prop_int(kid, "at_x", 0), at_scale))
    edit y = to_real(big(prop_int(kid, "at_y", 0), at_scale))
    if to is not "":
        on = rect_of(doc, acc, to)
        # `side: on` lies exactly over what it names, at its size. An
        # overlay marking where something will land has to be the shape of
        # the place, not a box the document guessed at.
        if side is "on":
            return Point{x: on.x, y: on.y}
        # `side: corner` hangs half off the top right of what it names. A
        # count on an inbox, a dot on a bell: every one of them sits there,
        # and a document should be able to say so without arithmetic.
        if side is "corner":
            return Point{x: on.x + on.wide - to_real(size.w) / 2.0, y: on.y - to_real(size.h) / 2.0}
        # Below by default, because a dropdown is the common case.
        x = if side is "right" then on.x + on.wide else if side is "left" then on.x - to_real(size.w) else on.x
        y = if side is "right" or side is "left" then on.y else if side is "above" then on.y - to_real(size.h) else on.y + on.high
        # Flipped rather than cut off.
        if y + to_real(size.h) > room.y + room.high and on.y - to_real(size.h) >= room.y:
            y = on.y - to_real(size.h)
        if x + to_real(size.w) > room.x + room.wide and on.x - to_real(size.w) >= room.x:
            x = on.x - to_real(size.w)
    # --- a point in the world, not a corner of the screen -------------------
    #
    # A nameplate belongs over a head, a damage number floats up from a hit,
    # a quest marker sits on a door. The game does the projecting - veil is
    # not a camera - and hands over a screen point. What veil owes it is the
    # two things every one of them needs and no menu does.
    #
    # `pin` says how the box sits ON the point rather than starting at it:
    # "over" is centred both ways, "above" is centred and lifted clear,
    # "below" is centred and dropped clear. A nameplate that starts at the
    # point sits down and to the right of the head it names.
    #
    # `world: 1` says the point is real, so it is NOT dragged back onto the
    # screen. A menu that would hang off the bottom should open upwards; a
    # nameplate whose owner walked behind you should be GONE, not pinned to
    # the edge shouting. Painting throws away what falls outside the clip,
    # so a plate off screen costs its own placement and nothing else.
    #
    # Depth is `order`, which children are already sorted by: the further
    # away, the smaller, so the near ones paint last and over.
    pin = prop_val(kid, "pin")
    if to is "":
        if pin is "over" or pin is "above" or pin is "below":
            x = x - to_real(size.w) / 2.0
        if pin is "above":
            y = y - to_real(size.h)
        if pin is "over":
            y = y - to_real(size.h) / 2.0
    if prop_val(kid, "world") is "1":
        return Point{x: x, y: y}
    # And held inside the room whatever happened, because a thing you
    # cannot see is worse than a thing in the wrong place.
    far_x = room.x + room.wide - to_real(size.w)
    far_y = room.y + room.high - to_real(size.h)
    kx = if x > far_x then far_x else x
    ky = if y > far_y then far_y else y
    Point{x: if kx < room.x then room.x else kx, y: if ky < room.y then room.y else ky}

# Place a child, trimmed to the box it goes in. `keeps` is false for a box
# that clips, where a child hanging outside is exactly what scrolling is.
# --- read the other way -----------------------------------------------------
#
# Arabic and Hebrew are not written right to left with a left-to-right screen
# around them: the whole screen turns over. The back arrow points the other
# way, the sidebar is on the right, the scrollbar is on the left, and a row of
# buttons runs the other direction.
#
# `dir: rtl` on the ROOT says so, and every box in the flow is mirrored inside
# its parent - which is one line in one place rather than a second version of
# the flow, and it means `align: start` means the right without knowing it
# does. Nesting takes care of itself: a child is mirrored in its parent and
# then mirrors its own children in itself.
#
# What is NOT mirrored: anything placed at a point it named itself. `at_x`
# is a screen coordinate, and a nameplate over a head does not move because
# the menus turned around.
#
# What this is not is bidi. A screen is in one direction here; an Arabic
# sentence with an English name in the middle of it needs the text engine to
# reorder the run, and that is a different piece of work.
define mirrored(doc: SemanticDocument) -> truth:
    if length(doc.nodes) is 0:
        return false
    prop_val(doc.nodes[doc.root], "dir") is "rtl"

define held(doc: SemanticDocument, theme: Theme, face: Font, k: number, x0: number, y0: number, w0: number, h0: number, acc: [Measured], sizes: Sizes, keeps: truth, ix: number, iy: number, iw: number, ih: number) -> [Measured]:
    at_scale = scale_now()
    # The margin was counted into the size the line was flowed with, so it
    # comes back off here: the box a thing actually gets is its own, and
    # the room it carries stays around it.
    edge = node_margin(doc.nodes[k], at_scale)
    y = y0 + edge
    w = if w0 - edge * 2 > 0 then w0 - edge * 2 else 0
    h = if h0 - edge * 2 > 0 then h0 - edge * 2 else 0
    # Turned over inside the box it was given, if the screen is.
    straight = x0 + edge
    x = if mirrored(doc) then ix + iw - (straight - ix) - w else straight
    if not keeps:
        return place_sized(doc, theme, face, k, x, y, w, h, acc, sizes)
    nx = if x < ix then ix else x
    ny = if y < iy then iy else y
    right = if x + w > ix + iw then ix + iw else x + w
    low = if y + h > iy + ih then iy + ih else y + h
    nw = if right > nx then right - nx else 0
    nh = if low > ny then low - ny else 0
    place_sized(doc, theme, face, k, nx, ny, nw, nh, acc, sizes)

define place_sized(doc: SemanticDocument, theme: Theme, face: Font, node_id: number, x: number, y: number, w: number, h: number, measured: [Measured], sizes: Sizes) -> [Measured]:
    # A subtree that is what it was, asked for the box it already had, is
    # already placed - `measured` came in holding the last frame's rects.
    # Nothing below it can have moved, so nothing below it is worked out
    # again. This is the whole of "only redo what changed" for placement,
    # and it is why a screen with one meter ticking costs one meter.
    if node_id < length(sizes.same):
        if sizes.same[node_id] is 1 and same_room(measured[node_id].rect, Rect{x: to_real(x), y: to_real(y), wide: to_real(w), high: to_real(h)}):
            return measured
    # Read once for this box and carried into every length it works out.
    at_scale = scale_now()
    node = doc.nodes[node_id]
    style = ready_style(theme, node, node_id, sizes.styles)
    # Rebound onto ITSELF, which is what makes this write in place. Naming
    # a new list here copied all 151 entries once per node - a whole
    # quadratic hidden in one innocent-looking assignment, and most of what
    # the frame region was being asked to hold.
    edit acc = measured
    acc = set(acc, node_id, Measured{node_id: node_id, rect: Rect{x: x, y: y, wide: w, high: h}})
    if length(node.children) is 0:
        acc
    else:
        how = arranging(node, style)
        row = how.row
        stacked = how.stacked
        cols = how.cols
        flows = how.flows
        pad = node_pad(node, style, at_scale)
        gap = node_gap(node, style, at_scale)
        ix = x + pad
        iy = y + pad
        iw = w - pad * 2
        ih = h - pad * 2
        main_inner = if row then iw else ih
        cross_inner = if row then ih else iw
        main_start = if row then ix else iy
        cross_start = if row then iy else ix
        # Children get the inner WIDTH to wrap against either way.
        cross_room = iw
        kids = child_order(doc, node)
        # Measure every child ONCE and keep it. This loop and the placement
        # loop below both need every child's size, and measuring re-walks
        # the whole subtree - doing it twice made the layout quadratic in
        # the depth of the tree. It was 25ms a frame on a screen with a few
        # hundred nodes, which is most of a frame gone before anything is
        # drawn.
        edit kid_sizes = []
        edit tall_sum = 0
        edit tallest = 0
        loop k in kids:
            raw = sized(doc, theme, face, sizes, k, cross_room)
            # A share of the room is settled HERE, before anything counts
            # what is left over. Settled after, a 70% fill and a grow:1
            # track each took their piece of the same space and the row
            # came out wider than the box it was in.
            pc = if row then prop_percent(doc.nodes[k], "w") else prop_percent(doc.nodes[k], "h")
            share = main_inner * pc // 100
            capped = if share > main_inner then main_inner else share
            shared = if pc >= 0 then with_main(raw, row, capped) else raw
            # Eased HERE, in the size the parent flows with, so everything
            # below a folding section slides up with it instead of waiting
            # for it to finish and then jumping.
            moved_in = travelling(doc.nodes[k], shared)
            edge = node_margin(doc.nodes[k], at_scale) * 2
            cs = Size2{w: moved_in.w + edge, h: moved_in.h + edge}
            kid_sizes = append(kid_sizes, cs)
            # Summed HERE rather than walked afterwards. Handing kid_sizes to
            # a function to add up its heights marks it as possibly somebody
            # else's, and an accumulator that might be somebody else's is
            # copied whole on every append - 739 milliseconds for twenty
            # thousand children instead of 13.
            tall_sum = tall_sum + cs.h
            if node_shown(doc.nodes[k]) and cs.h > tallest:
                tallest = cs.h
        edit content_main = 0
        edit total_grow = 0
        edit i = 0
        edit shown_kids = 0
        edit at_k = 0
        loop k in kids:
            if node_shown(doc.nodes[k]) and not floats(doc.nodes[k]):
                cs = kid_sizes[at_k]
                cm = if row then cs.w else cs.h
                if i > 0:
                    content_main = content_main + gap
                content_main = content_main + cm
                total_grow = total_grow + prop_int(doc.nodes[k], "grow", 0)
                i = i + 1
                shown_kids = shown_kids + 1
            at_k = at_k + 1
        leftover = main_inner - content_main
        # Too much content for the box: shrink everyone by the same
        # proportion so it fits. Without this a row of panels simply runs
        # off the edge of the window, which is what flow does when nobody
        # tells it the space ran out. Shrinking is not the same as growing
        # in reverse - `grow` shares out a surplus, this shares out a debt.
        # A clipping node has already said it accepts overflow - that is
        # what clipping MEANS - so it does not squeeze. Shrinking and
        # scrolling are the two answers to the same question and a node
        # picks one: refuse the overflow, or cut it.
        crowded = content_main > main_inner and main_inner > 0 and not flows
        squeeze = if crowded and not node_clips(node) then main_inner else 0
        # WHOSE room the debt comes out of. A child that said `w: 260` said
        # a number, not a preference - a sidebar that shrinks because the
        # page beside it wanted more is the whole reason things jumped and
        # got smaller on the way. So the debt is taken from the children
        # that named no size, and only if they cannot carry it all does
        # everyone shrink together.
        edit flex_main = 0
        edit at_f = 0
        loop k in kids:
            if node_shown(doc.nodes[k]):
                if not said_main(doc.nodes[k], row):
                    flex_main = flex_main + (if row then kid_sizes[at_f].w else kid_sizes[at_f].h)
                at_f = at_f + 1
        debt = if squeeze > 0 then content_main - main_inner else 0
        flexes = squeeze > 0 and flex_main > debt
        # Scrolling shifts where the children start. `end` works it out
        # from what did not fit; a number says it outright.
        overflow = if leftover < 0 then 0 - leftover else 0
        shift_main = if scrolls_to_end(node) and row then overflow else 0
        shift_x = if row then shift_main else node_scroll_x(node)
        shift_y = if row then node_scroll_y(node) else shift_main + node_scroll_y(node)
        # The first row the app handed over is not the first row there is.
        # Its index says where it belongs, and everything below follows from
        # there - which is why no empty spacer has to stand in for the rest.
        # Where the first row handed over belongs: its index times how tall a
        # row is - said outright, or the average of the ones in hand.
        # How tall a row is when they are not all the same: the average of
        # the ones in hand, summed while they were made. A chat log whose
        # lines wrap differently cannot say a number in advance, and
        # measuring all twenty-four thousand to find out would be the whole
        # cost back again - so the length of the list is a guess that gets
        # better as you go and is exact once you have been everywhere.
        row_step = if row_height(node) > 0 then row_height(node) else (if length(kid_sizes) > 0 then tall_sum // length(kid_sizes) else 0)
        edit cursor = if lists_lazily(node) then main_start + first_row(node) * row_step else main_start
        edit extra_gap = 0
        # A lazy list has room left over by definition - twelve rows in a box
        # that holds six - and justifying that space would put the twelve
        # back at the top, which is exactly where they do not belong.
        if total_grow is 0 and leftover > 0 and not lists_lazily(node):
            just = prop_val(node, "justify")
            if just is "between" and shown_kids > 1:
                extra_gap = leftover // (shown_kids - 1)
            else:
                cursor = main_start + align_factor(just) * leftover // 1000
        align = prop_val(node, "align")
        edit placed_n = 0
        edit at_p = 0
        edit line_w = 0
        edit flow_y = iy
        edit flow_h = 0
        loop k in kids:
            if node_shown(doc.nodes[k]):
                cs = kid_sizes[at_p]
                edit cm = if row then cs.w else cs.h
                cc = if row then cs.h else cs.w
                if total_grow > 0 and leftover > 0:
                    cm = cm + prop_int(doc.nodes[k], "grow", 0) * leftover // total_grow
                if squeeze > 0 and content_main > 0:
                    if flexes:
                        if not said_main(doc.nodes[k], row):
                            cm = cm * (flex_main - debt) // flex_main
                    else:
                        cm = cm * squeeze // content_main
                kid = doc.nodes[k]
                pc_cross = if row then prop_percent(kid, "h") else prop_percent(kid, "w")
                fillv = prop_val(kid, "fill")
                edit ccross = if pc_cross >= 0 then cross_inner * pc_cross // 100 else cc
                edit cross_off = 0
                # `fill` takes what is left ACROSS the flow - but it does not
                # overrule a size the node stated. A track that says it is
                # eight pixels tall is eight pixels tall in a row and in a
                # column both; `fill` is how it says "as wide as there is
                # room" in the one where width is the cross axis. Letting
                # fill win drew an eight-pixel bar inside a sixteen-pixel
                # track, sitting at its top edge.
                said_cross = said(kid, if row then "h" else "w")
                if (fillv is "1" or fillv is "true") and not said_cross.spoke:
                    ccross = cross_inner
                else:
                    cross_off = align_factor(align) * (cross_inner - ccross) // 1000
                # Held inside the box it is being placed in. A row that
                # ran out of room shrinks along the way it flows, but
                # nothing shrinks ACROSS it, so a ring or a picture taller
                # than its panel used to hang out the bottom of it and
                # over whatever came next. A box that clips is the
                # exception: being outside is the whole point of scrolling.
                keeps = not node_clips(node)
                if floats(kid):
                    room = acc[doc.root].rect
                    spot = float_spot(doc, acc, kid, cs, room)
                    over_it = prop_val(kid, "side") is "on"
                    lies_on = rect_of(doc, acc, node_at(kid))
                    kw2 = if over_it then to_whole(lies_on.wide) else cs.w
                    kh2 = if over_it then to_whole(lies_on.high) else cs.h
                    acc = place_sized(doc, theme, face, k, to_whole(spot.x), to_whole(spot.y), kw2, kh2, acc, sizes)
                else if flows:
                    # The SAME arithmetic flow_high measures with, so the
                    # two cannot disagree about where a line breaks.
                    # Counting the trailing gap as part of the used width
                    # AND adding one again for the next child charged a gap
                    # twice per item: placement broke a line earlier than
                    # measurement had, and the line measurement never knew
                    # about was trimmed away as outside the box.
                    step = if line_w is 0 then cs.w else line_w + gap + cs.w
                    fresh = line_w > 0 and step > iw
                    if fresh:
                        flow_y = flow_y + flow_h + gap
                        flow_h = 0
                        line_w = 0
                    at_x = if line_w is 0 then ix else ix + line_w + gap
                    acc = held(doc, theme, face, k, at_x, flow_y, cs.w, cs.h, acc, sizes, keeps, ix, iy, iw, ih)
                    line_w = if line_w is 0 then cs.w else line_w + gap + cs.w
                    flow_h = if cs.h > flow_h then cs.h else flow_h
                else if cols > 0:
                    # Column and row from the child's position in the list,
                    # not from where the cursor happens to have got to.
                    cell_w = (iw - gap * (cols - 1)) // cols
                    cell_h = tallest
                    # In a lazy grid the item handed over is not the first
                    # item there is: its own index says which cell it goes
                    # in. A bag of ten thousand slots showing forty is forty
                    # nodes, and the other nine thousand nine hundred and
                    # sixty are a number.
                    where = placed_n + if lists_lazily(node) then first_row(node) else 0
                    col_i = where % cols
                    row_i = where // cols
                    # Shifted by the scroll, like everything else in a box
                    # that scrolls. A grid never was, which nothing noticed
                    # while grids were short enough to fit.
                    acc = held(doc, theme, face, k, ix + col_i * (cell_w + gap) - shift_x, iy + row_i * (cell_h + gap) - shift_y, cell_w, cell_h, acc, sizes, keeps, ix, iy, iw, ih)
                    placed_n = placed_n + 1
                else if stacked:
                    # A child that was GIVEN a size keeps it and is placed
                    # by align/justify inside the box; one that was not
                    # fills. A stack that forced every child to the whole
                    # box could not hold an icon over a plate without
                    # blowing the icon up to the size of the plate.
                    kw = if given(kid, "w") or pc_cross >= 0 then cs.w else iw
                    kh = if given(kid, "h") then cs.h else ih
                    off_x = align_factor(prop_val(node, "justify")) * (iw - kw) // 1000
                    off_y = align_factor(align) * (ih - kh) // 1000
                    acc = held(doc, theme, face, k, ix + off_x, iy + off_y, kw, kh, acc, sizes, keeps, ix, iy, iw, ih)
                else if row:
                    acc = held(doc, theme, face, k, cursor - shift_x, cross_start + cross_off - shift_y, cm, ccross, acc, sizes, keeps, ix, iy, iw, ih)
                else:
                    acc = held(doc, theme, face, k, cross_start + cross_off - shift_x, cursor - shift_y, ccross, cm, acc, sizes, keeps, ix, iy, iw, ih)
                # A floating child took no room when the line was measured,
                # so it must not take any as the line is walked either -
                # otherwise everything after a tooltip sits a tooltip lower.
                if not floats(kid):
                    cursor = cursor + cm + gap + extra_gap
            at_p = at_p + 1
        acc

# Two-pass layout: measure intrinsic sizes, then place from the root 16[16],
# the root sized to its content (or its explicit w/h). resolve and pick_node
# consume the placed rects - one truth for paint and hit-test.
# Layout with the root placed in a GIVEN box - the screen-relative
# input `anchor` needs: the host says where the tree lives and how big
# its world is; the tree flows inside it.
public define layout_in(doc: SemanticDocument, theme: Theme, face: Font, box: Rect) -> [Measured]:
    place_all(doc, theme, face, measure_all(doc, theme, face), box)

# Placing, given sizes already worked out. Split out so a frame can reuse the
# sizes it did not have to work out again.
public define place_all(doc: SemanticDocument, theme: Theme, face: Font, sizes: Sizes, box: Rect) -> [Measured]:
    place_from(doc, theme, face, sizes, box, [])

# The same, starting from where everything was last time. A subtree that did
# not change and is asked for the box it already had keeps the rects it came
# in with, and is never walked.
public define place_from(doc: SemanticDocument, theme: Theme, face: Font, sizes: Sizes, box: Rect, was: [Measured]) -> [Measured]:
    n = length(doc.nodes)
    edit out = []
    if length(was) is n:
        # A copy, not the array itself: what came in is the frame before, and
        # the frame before is read again after this one is placed.
        loop m in was:
            out = append(out, m)
    else:
        loop i in 0 until n:
            out = append(out, Measured{node_id: i, rect: Rect{x: 0, y: 0, wide: 0, high: 0}})
    if n is 0:
        out
    else:
        place_sized(doc, theme, face, doc.root, to_whole(box.x), to_whole(box.y), to_whole(box.wide), to_whole(box.high), out, sizes)
# --- one frame told from the last one ---------------------------------------
#
# The document is rebuilt from scratch every frame, and almost none of it is
# different: moving the pointer from one button to the next changes ONE word
# on ONE node. Laying out and painting the whole screen to find that out is
# the thing every immediate-mode UI does and the thing that costs.
#
# So the frame before is kept, and the new document is read against it. A
# node whose properties and children are the same as they were, and whose
# children came out the same size, IS the same size - there is nothing to
# work out. If no size anywhere changed and the room is the same, no box
# moved either, and the whole placement stands.
#
# What this is NOT: a diff of the display list, or a tree the app mutates.
# The app still builds the whole document every frame, in one line, the way
# it always did. The comparing is the framework's business.
public type Frame: doc: SemanticDocument, sizes: Sizes, placed: [Measured], list: DisplayList, room: Rect, from_cmd: [number], to_cmd: [number], dress: Theme

# What a paint produced, and where each subtree's part of it starts and ends.
# The spans are what lets the next frame COPY a branch that did not change
# instead of working it out again.
public type Painted: list: DisplayList, from_cmd: [number], to_cmd: [number]

# Are these the same node, said the same way? Role, properties in order, and
# the same children. Five short comparisons for a node that did not change -
# against measuring its text, which is thousands of times that.
define same_node(a: Node, b: Node) -> truth:
    if a.role.name is not b.role.name:
        return false
    if length(a.props) is not length(b.props):
        return false
    if length(a.children) is not length(b.children):
        return false
    edit i = 0
    loop pa in a.props:
        pb = b.props[i]
        if pa.key is not pb.key or pa.content is not pb.content:
            return false
        i = i + 1
    edit k = 0
    loop ca in a.children:
        if ca is not b.children[k]:
            return false
        k = k + 1
    true

define same_size(a: Size2, b: Size2) -> truth:
    a.w is b.w and a.h is b.h

# The measuring pass, told what it worked out last time. A node is measured
# again only when it or its children are not what they were - and a subtree
# with wrapping text in it is always measured again, because its height
# depends on a width nobody knows until the way down.
define measure_again(doc: SemanticDocument, theme: Theme, face: Font, was: SemanticDocument, had: Sizes) -> Sizes:
    n = length(doc.nodes)
    if n is not length(was.nodes) or n is not length(had.box):
        return measure_all(doc, theme, face)
    # One list at a time, for the same reason measure_all does it: an
    # append only grows in place while its list is last in the region.
    zero = Size2{w: 0, h: 0}
    edit box = []
    loop i in 0 until n:
        box = append(box, zero)
    edit wraps = []
    loop i in 0 until n:
        wraps = append(wraps, 0)
    edit styles = []
    loop i in 0 until n:
        styles = append(styles, had.styles[i])
    edit fresh = []
    loop i in 0 until n:
        fresh = append(fresh, 0)
    edit same = []
    loop i in 0 until n:
        same = append(same, 0)
    loop i in 0 until n:
        node = doc.nodes[i]
        wraps = set(wraps, i, if wraps_below(doc, i, wraps) then 1 else 0)
        alike = same_node(node, was.nodes[i])
        edit kept = alike and wraps[i] is 0
        if kept:
            loop k in node.children:
                if fresh[k] is 1:
                    kept = false
        if kept:
            box = set(box, i, had.box[i])
        else:
            styles = set(styles, i, style_of(theme, node))
            was_size = had.box[i]
            now = measure_deep(doc, theme, face, i, 0, box, wraps, styles)
            box = set(box, i, now)
            if not same_size(was_size, now):
                fresh = set(fresh, i, 1)
        # And whether PLACING may skip it. Unchanged and the same size is
        # not enough: a box that scrolls keeps its properties while the
        # scroll it was given eases on, so its children move under it. The
        # same goes for anything below it, so the flag walks up the way
        # `fresh` walks up. Children come before parents in a document, so
        # one pass in index order sees them all.
        # Whether PLACING may skip it, which is a different question from
        # whether MEASURING could reuse its size. A node that wraps had to
        # be measured again - its height depends on the width it is given -
        # but if it came out the SAME size, in the same box, it is placed
        # the same way. Asking `kept` here let one wrapping paragraph stop
        # the whole page from being skipped with it.
        edit still = alike and fresh[i] is 0 and not slides(node)
        loop k in node.children:
            if same[k] is 0:
                still = false
        same = set(same, i, if still then 1 else 0)
    Sizes{box: box, wraps: wraps, styles: styles, same: same}

# A box whose contents move without its properties changing - which is to
# say: one that is scrolling RIGHT NOW.
#
# A scroll eases, so the box keeps its properties while what is inside it
# travels. That is why a scroller cannot be skipped, and because the flag
# walks up the tree, one scrolling list stops the whole page from being
# skipped with it.
#
# But only while it is on its way. A scroll that has arrived where it was
# asked to be moves nothing, and then the page is as still as it looks.
define slides(node: Node) -> truth:
    who = node_name(node)
    if who is "":
        return false
    at_scale = scale_now()
    sx = prop_val(node, "scroll_x")
    sy = prop_val(node, "scroll_y")
    if sx is not "" and not landed("{who}|sx", big(number_in(sx), at_scale)):
        return true
    sy is not "" and not landed("{who}|sy", big(number_in(sy), at_scale))

# Which subtrees drew what they drew: the node is what it was, it ended up
# where it was, and so did everything below it.
#
# Asking whether a node MOVED rather than which properties could have moved
# it is the whole reason this is safe. Scrolling changes no size and no
# property the eye would call layout, and it moves everything - a rule that
# tried to name the properties that matter would have missed it, and did.
define steady_below(doc: SemanticDocument, was: SemanticDocument, now: [Measured], before: [Measured]) -> [number]:
    n = length(doc.nodes)
    edit out = []
    loop i in 0 until n:
        out = append(out, 0)
    if n is not length(was.nodes) or n is not length(now) or n is not length(before):
        return out
    loop i in 0 until n:
        node = doc.nodes[i]
        edit still = same_node(node, was.nodes[i]) and same_room(now[i].rect, before[i].rect)
        loop k in node.children:
            if out[k] is 0:
                still = false
        out = set(out, i, if still then 1 else 0)
    out

# Is this the same theme, said the same way? Everything a frame reuses -
# the styles it did not look up again, the commands it copied - was worked
# out under a theme, and a screen that switches to a light one has to be
# told from nothing. Sixty rules compared once a frame, not once a node.
define same_theme(a: Theme, b: Theme) -> truth:
    if length(a.rules) is not length(b.rules):
        return false
    edit i = 0
    edit same = true
    loop r in a.rules:
        o = b.rules[i]
        if r.role_name is not o.role_name or r.padding is not o.padding or r.gap is not o.gap or r.fg_colour is not o.fg_colour or r.bg_colour is not o.bg_colour or r.direction is not o.direction or r.radius is not o.radius or r.size is not o.size or r.border is not o.border or r.border_colour is not o.border_colour or r.shadow is not o.shadow or r.shadow_colour is not o.shadow_colour:
            same = false
        i = i + 1
    same

define same_room(a: Rect, b: Rect) -> truth:
    a.x is b.x and a.y is b.y and a.wide is b.wide and a.high is b.high

# The first frame: everything from nothing.
public define first_frame(doc: SemanticDocument, theme: Theme, face: Font, room: Rect) -> Frame:
    sizes = measure_all(doc, theme, face)
    placed = place_all(doc, theme, face, sizes, room)
    drawn = paint_spans(doc, theme, face, placed)
    Frame{doc: doc, sizes: sizes, placed: placed, list: drawn.list, room: room, from_cmd: drawn.from_cmd, to_cmd: drawn.to_cmd, dress: theme}

# Every frame after: as much of the one before as still holds.
public define next_frame(before: Frame, doc: SemanticDocument, theme: Theme, face: Font, room: Rect) -> Frame:
    n = length(doc.nodes)
    if n is 0 or n is not length(before.doc.nodes) or not same_theme(theme, before.dress):
        return first_frame(doc, theme, face, room)
    sizes = measure_again(doc, theme, face, before.doc, before.sizes)
    placed = place_from(doc, theme, face, sizes, room, before.placed)
    # Every branch that is what it was AND ended up where it was drew what
    # it drew, so its commands are copied out of the frame before instead of
    # being worked out again. Only what changed is painted.
    if highest_layer(doc) is 0 and length(before.from_cmd) is n and length(before.placed) is n:
        told = paint_told(doc, theme, face, placed, before, steady_below(doc, before.doc, placed, before.placed))
        return Frame{doc: doc, sizes: sizes, placed: placed, list: told.list, room: room, from_cmd: told.from_cmd, to_cmd: told.to_cmd, dress: theme}
    moved = paint_spans(doc, theme, face, placed)
    Frame{doc: doc, sizes: sizes, placed: placed, list: moved.list, room: room, from_cmd: moved.from_cmd, to_cmd: moved.to_cmd, dress: theme}



public define layout(doc: SemanticDocument, theme: Theme, face: Font) -> [Measured]:
    n = length(doc.nodes)
    edit out = []
    loop i in 0 until n:
        out = append(out, Measured{node_id: i, rect: Rect{x: 0, y: 0, wide: 0, high: 0}})
    if n is 0:
        out
    else:
        rs = measure(doc, theme, face, doc.root)
        place_sized(doc, theme, face, doc.root, 16, 16, rs.w, rs.h, out, measure_all(doc, theme, face))

# Resolve against a host-given root box (see layout_in).
public define resolve_in(doc: SemanticDocument, theme: Theme, face: Font, box: Rect) -> DisplayList:
    paint(doc, theme, face, layout_in(doc, theme, face, box))

# --- one layout, used for everything ---------------------------------------
# resolve_in, pick_spoken and every stage lookup each laid the tree out
# again, so an app that drew, hovered and asked where one node was paid for
# THREE full layouts a frame - measuring every run of text three times over.
# The layout is the expensive thing; do it once and hand it round.
#
#     placed = layout_in(doc, theme, face, box)
#     list = resolve_placed(doc, theme, face, placed)
#     who = pick_placed(doc, theme, placed, mx, my)
public define resolve_placed(doc: SemanticDocument, theme: Theme, face: Font, placed: [Measured]) -> DisplayList:
    paint(doc, theme, face, placed)

# --- a name that outlives the frame it was found in -------------------------
# What a pick returns is a pointer INTO the document, and the document is
# built in the frame region: reclaimed every frame, and freed outright
# when the region is resized. Every app holds the hovered and the focused
# name across frames - that is what they are FOR - so every app was
# holding a pointer to nothing and finding out about it seconds later,
# somewhere else entirely. Wrapping the copy in a persist scope was not
# enough; the copy still came out inside the frame buffer.
#
# The name is stashed under itself in the slot store, which has a copier
# that evacuates for real. Each distinct name gets one stable home, and
# picking the same thing twice reuses it, so the store is bounded by how
# many things the UI has rather than by how long it has been running.
define kept(name: text) -> text:
    if name is "":
        return ""
    k = "veil:name:{name}"
    if not slot_has(k):
        put = slot_set(k, "{name}")
    slot_get(k)

public define pick_placed(doc: SemanticDocument, theme: Theme, placed: [Measured], x: number, y: number) -> text:
    if length(doc.nodes) is 0:
        return ""
    edit layer = highest_layer(doc)
    edit spoken = ""
    loop:
        if layer < 0 or spoken is not "":
            break
        spoken = pick_layer(doc, theme, placed, doc.root, x, y, "", layer, 0)
        layer = layer - 1
    kept(spoken)

# --- moving by direction ---------------------------------------------------
# What lies to the RIGHT of the thing you are on. A list like `tab_order`
# is something somebody has to keep in step with the screen, and it can
# only ever answer "next" - it has no idea what is above or beside
# anything. This reads the rects the layout already worked out, so a
# D-pad, the arrow keys and a screen reader all get the same answer, and
# nobody maintains a list.
#
# `dx`/`dy` are the direction: (1,0) right, (0,-1) up. The nearest thing
# whose centre lies that way wins, with sideways drift counted double -
# a control straight ahead beats a nearer one off to the side, which is
# what a thumb on a stick expects.
public define near_toward(doc: SemanticDocument, placed: [Measured], from: text, dx: number, dy: number) -> text:
    here = rect_of(doc, placed, from)
    fx = here.x + here.wide / 2.0
    fy = here.y + here.high / 2.0
    # An arrow stays on the top layer too, for the same reason Tab does.
    levels = layers_of(doc)
    top = top_layer(levels)
    # And it stays in its zone. There is nothing over there once the panel
    # ends - that is what a panel IS. A screen that names no zones has one
    # called "", and then this line does nothing.
    zones = zones_of(doc)
    mine_zone = zone_at(doc, zones, from)
    edit best = ""
    edit best_score = 0
    loop m in placed:
        node = doc.nodes[m.node_id]
        name = node_do(node)
        r = m.rect
        if name is not "" and name is not from and r.wide > 0.0 and r.high > 0.0 and levels[m.node_id] is top and zones[m.node_id] is mine_zone:
            cx = r.x + r.wide / 2.0
            cy = r.y + r.high / 2.0
            ahead = to_whole((cx - fx) * to_real(dx) + (cy - fy) * to_real(dy))
            aside = to_whole(abs_real((cx - fx) * to_real(dy) - (cy - fy) * to_real(dx)))
            # Only things genuinely that way, and only if they are more
            # that way than they are off to the side.
            if ahead > 0 and ahead >= aside:
                score = ahead + aside * 2
                if best is "" or score < best_score:
                    best = name
                    best_score = score
    kept(best)

define abs_real(v: number) -> number:
    if v < 0.0 then 0.0 - v else v

# --- only the rows you can see ---------------------------------------------
# A list of ten thousand rows must not become ten thousand nodes. The
# document asks which slice of them is on screen and builds only those,
# with an empty box above and below standing in for the rest so the
# scrollbar and the scroll offset are still telling the truth.
#
# This is arithmetic, not machinery: rows are a known height, the box is a
# known height, and the offset says how far down you are. It lives here
# because getting it wrong by one row is the kind of mistake every app
# would otherwise make on its own.
public type Window: first: number, count: number, above: number, below: number

public define row_window(total: number, row_high: number, box_high: number, away: number) -> Window:
    if row_high <= 0 or total <= 0:
        return Window{first: 0, count: 0, above: 0, below: 0}
    top = if away < 0 then 0 else away
    first = top // row_high
    # One row of slack at each end, so a row that is half on screen is
    # built rather than popping in at its own edge.
    start = if first > 0 then first - 1 else 0
    fits = box_high // row_high + 3
    count = if start + fits > total then total - start else fits
    kept = if count < 0 then 0 else count
    Window{first: start, count: kept, above: start * row_high, below: (total - start - kept) * row_high}

# --- looking at the layout itself -------------------------------------------
# Every box drawn as an outline with its role, its name and its size on it.
# When something is a pixel out or a panel is mysteriously twice as tall as
# it looks, the answer is always in the rects, and the rects are right here
# - so seeing them should not mean adding a print to the resolver.
#
#     list = resolve_placed(doc, theme, face, placed)
#     if showing_boxes:
#         list = with_boxes(doc, theme, face, placed, list)
#
# Deliberately ugly: it is a tool, and a tool that looks like the product
# gets left on by accident.
public define with_boxes(doc: SemanticDocument, theme: Theme, face: Font, placed: [Measured], into: DisplayList) -> DisplayList:
    if length(doc.nodes) is 0:
        return into
    boxes_in(doc, placed, doc.root, into, placed[doc.root].rect)

# Walked as a TREE, carrying the box each node is allowed to show inside.
# Drawn flat, every outline was drawn whole - including the empty box that
# stands in for ten thousand rows nobody built, which is a quarter of a
# million pixels tall and drew a line straight across the window. What is
# clipped on screen has to be clipped here or the tool lies about the
# thing it exists to show.
define boxes_in(doc: SemanticDocument, placed: [Measured], node_id: number, into: DisplayList, room: Rect) -> DisplayList:
    node = doc.nodes[node_id]
    edit out = into
    if node_shown(node):
        r = seen_part(placed[node_id].rect, room)
        if r.wide > 0.0 and r.high > 0.0:
            edge = if node_do(node) is not "" then "#3ec98acc" else "#e8a33c66"
            out = push_cmd(out, DrawRect(Rect{x: r.x, y: r.y, wide: r.wide, high: 1.0}, edge, node_id))
            out = push_cmd(out, DrawRect(Rect{x: r.x, y: r.y + r.high - 1.0, wide: r.wide, high: 1.0}, edge, node_id))
            out = push_cmd(out, DrawRect(Rect{x: r.x, y: r.y, wide: 1.0, high: r.high}, edge, node_id))
            out = push_cmd(out, DrawRect(Rect{x: r.x + r.wide - 1.0, y: r.y, wide: 1.0, high: r.high}, edge, node_id))
        inner = if node_clips(node) then seen_part(placed[node_id].rect, room) else room
        loop k in node.children:
            out = boxes_in(doc, placed, k, out, inner)
    out

# What of `r` is inside `room`.
define seen_part(r: Rect, room: Rect) -> Rect:
    x0 = if r.x > room.x then r.x else room.x
    y0 = if r.y > room.y then r.y else room.y
    x1 = if r.x + r.wide < room.x + room.wide then r.x + r.wide else room.x + room.wide
    y1 = if r.y + r.high < room.y + room.high then r.y + r.high else room.y + room.high
    Rect{x: x0, y: y0, wide: if x1 > x0 then x1 - x0 else 0.0, high: if y1 > y0 then y1 - y0 else 0.0}

# The one box under a point, said in words: what it is, what it answers to,
# and how big it came out. What you actually want when you are staring at
# something that is the wrong size.
public define box_told(doc: SemanticDocument, placed: [Measured], node_id: number) -> text:
    if node_id < 0 or node_id >= length(placed):
        return ""
    node = doc.nodes[node_id]
    r = placed[node_id].rect
    name = if node_name_of(node) is not "" then " {node_name_of(node)}" else ""
    "{node.role.name}{name}  {to_whole(r.wide)} x {to_whole(r.high)}  vid {to_whole(r.x)},{to_whole(r.y)}"

define node_name_of(node: Node) -> text:
    n = prop_val(node, "id")
    if n is not "" then n else prop_val(node, "do")

# --- reading order ---------------------------------------------------------
# Everything that answers to a name, in the order a person reads it: down
# the page, and left to right within a line. Tab has walked a hand-written
# list until now, which is a list somebody has to remember to update, and
# which quietly stops matching the screen the day a control moves. This is
# derived from where things actually ended up, so it cannot go stale.
#
# It is also what a screen reader wants, and the two should never be two
# different orders.
# The layer each node ends up on: its own if it says one, its parent's
# otherwise. Painting has always worked this way - `told_within` carries the
# layer down - and the ring has to agree with it. Without that a dialog
# opens and Tab keeps walking the page behind it, which is the one thing a
# modal must not do: you cannot see where the ring went, and Enter presses
# something you are not looking at.
define layers_of(doc: SemanticDocument) -> [number]:
    if length(doc.nodes) is 0:
        return []
    layers_from(doc, doc.root, 0, filled(length(doc.nodes), 0))

define layers_from(doc: SemanticDocument, node_id: number, inherited: number, into: [number]) -> [number]:
    node = doc.nodes[node_id]
    mine = if node_layer(node) > inherited then node_layer(node) else inherited
    edit out = set(into, node_id, mine)
    loop k in node.children:
        out = layers_from(doc, k, mine, out)
    out

# The topmost layer anything actually sits on. Everything below it is behind
# whatever is open, and the ring stays out of it.
define top_layer(levels: [number]) -> number:
    edit high = 0
    loop l in levels:
        if l > high:
            high = l
    high

public define reading_order(doc: SemanticDocument, placed: [Measured]) -> [text]:
    levels = layers_of(doc)
    top = top_layer(levels)
    edit rows = []
    loop m in placed:
        node = doc.nodes[m.node_id]
        if node_do(node) is not "" and m.rect.wide > 0.0 and m.rect.high > 0.0 and levels[m.node_id] is top:
            rows = append(rows, m)
    # "Already taken" is a MARK beside each row, not a list to scan. Scanning
    # it turned a selection sort into a cubic one and, because the scan hands
    # the list to itself, it also stopped the list growing where it stood - so
    # every take copied it whole. Thirty controls never noticed; a screen with
    # a thousand would have.
    edit gone = []
    loop _g in 0 until length(rows):
        gone = append(gone, 0)
    edit out = []
    loop _p in 0 until length(rows):
        edit best = 0 - 1
        edit best_key = 0
        edit i = 0
        loop m in rows:
            if gone[i] is 0:
                # A line is worth more than a column, and a line is eight
                # pixels deep - two things side by side are on the same
                # line even if one sits a hair lower.
                key = to_whole(m.rect.y) // 8 * 10000 + to_whole(m.rect.x)
                if best < 0 or key < best_key:
                    best = i
                    best_key = key
            i = i + 1
        gone = set(gone, best, 1)
        out = append(out, kept(node_do(doc.nodes[rows[best].node_id])))
    out

# --- zones ------------------------------------------------------------------
#
# A game screen is eight panels, not one long ring. The stick should walk
# WITHIN the bags; the shoulder buttons should move to the map. That is how
# every console UI has worked since consoles had one, and a flat ring through
# a hundred controls is why the ones that skip it feel broken.
#
# A zone is a prop that everything inside inherits, exactly the way a layer
# is: `p("zone", "bags")` on the panel, and the whole panel is the bags. A
# screen that says nothing has one zone called "" - and then none of this
# changes anything, which is why it can be the default.
#
# The ring MOVING is zone-bound; Tab is not. An arrow or a stick means "the
# next thing over there", and there is nothing over there once the panel ends.
# Tab means "the next thing on this screen", and it always has.

define zones_of(doc: SemanticDocument) -> [text]:
    if length(doc.nodes) is 0:
        return []
    edit blank = []
    loop _i in 0 until length(doc.nodes):
        blank = append(blank, "")
    zones_from(doc, doc.root, "", blank)

define zones_from(doc: SemanticDocument, node_id: number, inherited: text, into: [text]) -> [text]:
    node = doc.nodes[node_id]
    said = prop_val(node, "zone")
    mine = if said is not "" then said else inherited
    edit out = set(into, node_id, mine)
    loop k in node.children:
        out = zones_from(doc, k, mine, out)
    out

# Which zone the thing called `name` is in, "" when the screen has none.
public define zone_of(doc: SemanticDocument, name: text) -> text:
    zones = zones_of(doc)
    edit found = ""
    loop i in 0 until length(doc.nodes):
        if node_name(doc.nodes[i]) is name:
            found = zones[i]
    found

# Every zone that has something to focus in it, in reading order - so a
# shoulder button can walk them in the order the eye would.
public define zone_names(doc: SemanticDocument, placed: [Measured]) -> [text]:
    zones = zones_of(doc)
    order = reading_order(doc, placed)
    edit out = []
    loop name in order:
        z = zone_at(doc, zones, name)
        edit seen = false
        loop had in out:
            if had is z:
                seen = true
        if not seen:
            out = append(out, kept(z))
    out

define zone_at(doc: SemanticDocument, zones: [text], name: text) -> text:
    edit found = ""
    loop i in 0 until length(doc.nodes):
        if node_name(doc.nodes[i]) is name:
            found = zones[i]
    found

# Reading order inside one zone. What the ring walks when a panel has it,
# and where it lands when a panel is entered: the first of these.
public define reading_order_in(doc: SemanticDocument, placed: [Measured], zone: text) -> [text]:
    zones = zones_of(doc)
    edit out = []
    loop name in reading_order(doc, placed):
        if zone_at(doc, zones, name) is zone:
            out = append(out, name)
    out

# What a node should be CALLED when it is read out, which is not always
# what it shows: an icon button shows nothing to read, and a chevron shows
# nothing useful. `says:` is that name. It falls back to the words the
# node displays and then to the name it answers to, so most nodes need
# nothing - and it is a SEPARATE prop from `label`, which is one of the
# ways a node carries its visible text.
public define spoken_name(node: Node) -> text:
    l = prop_val(node, "says")
    if l is not "" then l else if node_text(node) is not "" then node_text(node) else node_do(node)

# --- the screen, said out loud ----------------------------------------------
#
# A blind person uses a program through a screen reader, and a screen reader
# needs to be TOLD what is there - it cannot look at pixels. veil already
# knows every part of the answer: what each thing is (its role), what it is
# called (`spoken_name`), what state it is in, and the order a person reads
# them (`reading_order`, derived from where they actually ended up).
#
# So this is not new knowledge, it is the knowledge gathered in one place and
# handed to whoever can speak it: the page turns it into ARIA, and a native
# host into whatever its platform uses. The one rule is that this list and
# the ring walk the SAME order, because a screen reader and a keyboard are
# the same person navigating the same screen.
# `role_name` rather than `role`, because the wasm backend lays struct fields
# out by NAME across the whole program and `Node.role` is a Role, not a word.
# StyleRule already calls the same thing role_name.
public type Spoken: name: text, role_name: text, says: text, state: text

public define spoken_screen(doc: SemanticDocument, placed: [Measured]) -> [Spoken]:
    edit out = []
    loop who in reading_order(doc, placed):
        edit found = 0 - 1
        loop i in 0 until length(doc.nodes):
            if node_name(doc.nodes[i]) is who:
                found = i
        if found >= 0:
            node = doc.nodes[found]
            out = append(out, Spoken{name: kept(who), role_name: kept(node.role.name), says: kept(spoken_name(node)), state: kept(said_state(node))})
    out

# What a thing is DOING, in one word: what a reader says after the name.
# `off` beats everything - a control nobody can use is not a control that is
# merely unchecked.
define said_state(node: Node) -> text:
    if node_off(node):
        return "off"
    s = prop_val(node, "state")
    if s is not "" then s else ""

# The rect of the node that answers to `name`, out of a layout already
# done. What a host needs when it draws its own art into a reserved box.
public define rect_of(doc: SemanticDocument, placed: [Measured], name: text) -> Rect:
    edit found = Rect{x: 0.0, y: 0.0, wide: 0.0, high: 0.0}
    loop m in placed:
        # By NAME, which is `id` or `do` - anchoring a tooltip or an
        # overlay to something that carries only an `id` used to find
        # nothing at all and place itself at the corner of the screen.
        if node_name(doc.nodes[m.node_id]) is name:
            found = m.rect
    found


# --- keeping the ring in sight ----------------------------------------------
#
# Walking a list with a pad or the arrow keys walks past the bottom of the box
# within three steps, and then the ring is on something nobody can see - which
# is worse than not moving at all.
#
# veil answers WHERE the box should be. The app owns the number, the way it
# owns every other piece of state: write the answer back into the same
# `scroll_y` the box already reads, and the next frame is in the right place.
# Nothing here reaches into the document or remembers anything.

define parent_of(doc: SemanticDocument, child: number) -> number:
    edit found = 0 - 1
    loop i in 0 until length(doc.nodes):
        loop k in doc.nodes[i].children:
            if k is child:
                found = i
    found

define id_named(doc: SemanticDocument, name: text) -> number:
    edit found = 0 - 1
    loop i in 0 until length(doc.nodes):
        if node_name(doc.nodes[i]) is name:
            found = i
    found

# The nearest box above `name` that scrolls, by name - "" when nothing above
# it does. That is also how an app asks "is this thing even in a list?".
public define scroller_of(doc: SemanticDocument, name: text) -> text:
    edit at = parent_of(doc, id_named(doc, name))
    loop:
        if at < 0:
            break
        if node_rolls(doc.nodes[at]) and node_name(doc.nodes[at]) is not "":
            return node_name(doc.nodes[at])
        at = parent_of(doc, at)
    ""

# How far that box has to be scrolled for `name` to sit wholly inside it, in
# the app's own numbers - the same ones it wrote into `scroll_y`.
#
# Something already in view answers with the scroll the box has NOW, so an
# app can write the answer back every frame without first asking whether it
# needed to. A `margin` of a row or two keeps the ring off the very edge,
# which is what makes a list feel like it is being read rather than paged.
public define scroll_to_show(doc: SemanticDocument, placed: [Measured], name: text, margin: number) -> number:
    box_name = scroller_of(doc, name)
    if box_name is "":
        return 0
    box_id = id_named(doc, box_name)
    me = id_named(doc, name)
    if box_id < 0 or me < 0:
        return 0
    now = prop_int(doc.nodes[box_id], "scroll_y", 0)
    box = placed[box_id].rect
    mine = placed[me].rect
    edge = big(margin, scale_now())
    # Above the top, or below the bottom. Both are measured in placed pixels
    # and handed back in the app's, because the app is what reads them.
    above = to_whole(box.y) + edge - to_whole(mine.y)
    below = to_whole(mine.y + mine.high) + edge - to_whole(box.y + box.high)
    at_scale = scale_now()
    if above > 0:
        return now - un_big(above, at_scale)
    if below > 0:
        return now + un_big(below, at_scale)
    now

# A length in placed pixels, back in the numbers the app writes.
define un_big(v: number, at_scale: number) -> number:
    if at_scale is 100 then v else (v * 100 + at_scale // 2) // at_scale

# How long the list in a scrolling box actually is, and how much of it shows.
# A stick that scrolls needs both, and so does anything that wants to say
# "page down" - the scrollbar has been working them out privately since the
# day it was written.
public define content_reach(doc: SemanticDocument, placed: [Measured], name: text) -> number:
    id = id_named(doc, name)
    if id < 0:
        return 0
    content_below(doc, placed, id, placed[id].rect)

public define content_seen(doc: SemanticDocument, placed: [Measured], name: text) -> number:
    id = id_named(doc, name)
    if id < 0:
        return 0
    to_whole(placed[id].rect.high)

# Scrolling by hand: a stick pushed this far moves the box this many pixels.
# Sixteen a frame at full push is a page a second, which is the speed a
# thumb expects - fast enough to cross a long list, slow enough to stop on
# a row. Below the dead zone nothing moves at all.
public define scroll_by_stick(now: number, push: number, reach: number, seen: number) -> number:
    step = to_whole(push * 16.0)
    want = now + step
    most = if reach > seen then reach - seen else 0
    if want < 0 then 0 else if want > most then most else want

public define resolve(doc: SemanticDocument, theme: Theme, face: Font) -> DisplayList:
    paint(doc, theme, face, layout(doc, theme, face))

# Paint walks the TREE from the root, parent before child, so a container's
# background lands under its contents. It used to walk the node ARRAY in
# index order, which quietly required every document to list parents before
# children - a document that builds bottom-up (children first, root last)
# had its root paint over everything it contained. The array is storage;
# the tree is the document.
# Painting a frame when the one before it is known and nothing has moved.
#
# A branch that is what it was, drawn in boxes that are where they were,
# draws what it drew - so its commands are copied out of the last frame in
# one go instead of being worked out again. Only the branches that changed,
# and the boxes that contain them, are painted at all.
#
# This is only done when the document has ONE layer. Raised things are
# painted in a pass of their own, so a node's commands are not one run of
# the list and there is nothing to copy.
define paint_told(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured], before: Frame, steady: [number]) -> Painted:
    if length(doc.nodes) is 0:
        return Painted{list: empty_list(), from_cmd: [], to_cmd: []}
    n = length(doc.nodes)
    edit starts = []
    edit ends = []
    loop i in 0 until n:
        starts = append(starts, 0)
        ends = append(ends, 0)
    told_within(doc, theme, face, measured, doc.root, empty_list(), 0, 0, 100, screen_of(doc, measured), 0, "", before, steady, starts, ends)

# The same walk `paint_within` does, carrying the spans - and turning back
# at the top of any branch it can copy whole.
define told_within(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured], node_id: number, into: DisplayList, want: number, inherited: number, dim: number, room: Rect, room_rad: number, whose: text, before: Frame, steady: [number], starts: [number], ends: [number]) -> Painted:
    node = doc.nodes[node_id]
    began = length(into.commands)
    if steady[node_id] is 1 and node_id < length(before.from_cmd):
        was_from = before.from_cmd[node_id]
        was_to = before.to_cmd[node_id]
        edit copied = into
        edit c = was_from
        loop:
            if c >= was_to:
                break
            copied = push_cmd(copied, before.list.commands[c])
            c = c + 1
        # Everything BELOW this branch drew where it drew too, just further
        # along the list. Without carrying their spans over, the next frame
        # would trust positions from two frames ago and copy the wrong run -
        # which paints most of a screen as nothing at all.
        moved_by = began - was_from
        after = slid_spans(doc, node_id, before, set(starts, node_id, began), set(ends, node_id, length(copied.commands)), moved_by)
        return Painted{list: copied, from_cmd: after.from_cmd, to_cmd: after.to_cmd}
    ours = if node_name(node) is not "" then node_name(node) else whose
    mine = if node_layer(node) > inherited then node_layer(node) else inherited
    mine_rect = measured[node_id].rect
    # The same as in paint_within, for the same reason.
    if hidden_by(mine_rect, room):
        return Painted{list: into, from_cmd: set(starts, node_id, began), to_cmd: set(ends, node_id, began)}
    mist = dim * prop_int(node, "fade", 100) // 100
    edit list = if mine is want then paint_one(doc, theme, face, measured, node_id, into, mist, ours) else into
    clipping = node_clips(node) and mine is want
    mine_rad = if clipping then node_radius(node, style_of(theme, node), scale_now()) else 0
    cut_to = if clipping then both_of(mine_rect, room) else room
    if clipping:
        list = push_cmd(list, SetClip(cut_to, mine_rad, node_id))
    inner_rad = if clipping then mine_rad else room_rad
    edit from_out = starts
    edit to_out = ends
    loop k in child_order(doc, node):
        if node_shown(doc.nodes[k]):
            got = told_within(doc, theme, face, measured, k, list, want, mine, mist, cut_to, inner_rad, ours, before, steady, from_out, to_out)
            list = got.list
            from_out = got.from_cmd
            to_out = got.to_cmd
    if clipping:
        list = push_cmd(list, SetClip(room, room_rad, node_id))
        if node_bars(node):
            list = add_bar_for(doc, theme, measured, node_id, list)
    Painted{list: list, from_cmd: set(from_out, node_id, began), to_cmd: set(to_out, node_id, length(list.commands))}

# A copied branch's children kept their order and their contents; only where
# they sit in the list moved. Said once here rather than re-derived.
define slid_spans(doc: SemanticDocument, node_id: number, before: Frame, starts: [number], ends: [number], moved_by: number) -> Painted:
    edit from_out = starts
    edit to_out = ends
    loop k in doc.nodes[node_id].children:
        if k < length(before.from_cmd):
            from_out = set(from_out, k, before.from_cmd[k] + moved_by)
            to_out = set(to_out, k, before.to_cmd[k] + moved_by)
            deeper = slid_spans(doc, k, before, from_out, to_out, moved_by)
            from_out = deeper.from_cmd
            to_out = deeper.to_cmd
    Painted{list: empty_list(), from_cmd: from_out, to_cmd: to_out}

# The ordinary paint, with the spans recorded so the NEXT frame can copy.
define paint_spans(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured]) -> Painted:
    n = length(doc.nodes)
    edit starts = []
    edit ends = []
    loop i in 0 until n:
        starts = append(starts, 0)
        ends = append(ends, 0)
    if n is 0 or highest_layer(doc) > 0:
        return Painted{list: paint(doc, theme, face, measured), from_cmd: starts, to_cmd: ends}
    told_within(doc, theme, face, measured, doc.root, empty_list(), 0, 0, 100, screen_of(doc, measured), 0, "", Frame{doc: doc, sizes: Sizes{box: [], wraps: [], styles: []}, placed: measured, list: empty_list(), room: no_clip(), from_cmd: [], to_cmd: [], dress: theme}, starts, starts, ends)

define paint(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured]) -> DisplayList:
    # An empty document has no root to start from - `root` is still 0.
    if length(doc.nodes) is 0:
        return empty_list()
    edit list = empty_list()
    edit layer = 0
    top_layer = highest_layer(doc)
    loop:
        if layer > top_layer:
            break
        list = paint_layer(doc, theme, face, measured, doc.root, list, layer, 0)
        layer = layer + 1
    list

define highest_layer(doc: SemanticDocument) -> number:
    edit high = 0
    loop node in doc.nodes:
        l = node_layer(node)
        if l > high:
            high = l
    high

# Paint the nodes belonging to `want`. A node inherits its parent's layer
# unless it names a higher one, so a dialog lifts everything inside it.
define paint_layer(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured], node_id: number, into: DisplayList, want: number, inherited: number) -> DisplayList:
    paint_faded(doc, theme, face, measured, node_id, into, want, inherited, 100)

# `fade: 0..100` on a node dims EVERYTHING it draws, and everything its
# children draw. Fading a panel by fading each colour in it one at a time
# is not the same thing: the shadows, the borders and the text have to go
# together or the panel comes apart on its way out.
define paint_faded(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured], node_id: number, into: DisplayList, want: number, inherited: number, dim: number) -> DisplayList:
    paint_within(doc, theme, face, measured, node_id, into, want, inherited, dim, screen_of(doc, measured), 0, "")

# A clipping box, when it is done, has to give back the clip it was
# INSIDE - not turn clipping off. Turning it off let everything painted
# after it escape: scroll a page whose panels clip and the whole page
# drew itself over the header, because the first panel to finish had
# switched the page's own clip off on its way out.
define paint_within(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured], node_id: number, into: DisplayList, want: number, inherited: number, dim: number, room: Rect, room_rad: number, whose: text) -> DisplayList:
    node = doc.nodes[node_id]
    # Motion is INHERITED, the way the clip is. A button carries a name
    # and its label does not, so the plate used to travel while the words
    # on it jumped - the same state change happening two different ways in
    # one control, which is what makes a screen feel unfinished. Anything
    # inside a named thing moves with it.
    ours = if node_name(node) is not "" then node_name(node) else whose
    mine = if node_layer(node) > inherited then node_layer(node) else inherited
    mine_rect = measured[node_id].rect
    # Nothing outside the clip can be seen, so nothing outside it is drawn -
    # and neither is anything inside it. A list of twenty thousand rows in a
    # box that shows thirty-three sent twenty thousand draw commands to the
    # painter, all but thirty-three to be thrown away by a scissor test on
    # the other side.
    #
    # A box with NO SIZE is not outside anything: a group that measures zero
    # can still hold a dialog, so it is walked.
    #
    # What this does mean is that a subtree scrolled out of view raises
    # nothing either - a menu opened from a row that has since scrolled away
    # is gone with the row. That is what every toolkit does and what the eye
    # expects.
    if hidden_by(mine_rect, room):
        return into
    mist = dim * prop_int(node, "fade", 100) // 100
    edit list = if mine is want then paint_one(doc, theme, face, measured, node_id, into, mist, ours) else into
    clipping = node_clips(node) and mine is want
    # Only a box that CLIPS needs to know how round it is, and few do - but
    # this worked it out for every node on the screen, and working it out
    # means finding the node's rule in the theme, which is a walk down
    # sixty of them for an answer thrown away.
    mine_rad = if clipping then node_radius(node, style_of(theme, node), scale_now()) else 0
    # Nested clips INTERSECT. Replacing the enclosing one let a panel
    # scrolled half off the top of a page draw the half that was above the
    # page, because its own box still reached down into view - the page's
    # clip had been thrown away rather than cut against.
    cut_to = if clipping then both_of(mine_rect, room) else room
    if clipping:
        list = push_cmd(list, SetClip(cut_to, mine_rad, node_id))
    inner = cut_to
    inner_rad = if clipping then mine_rad else room_rad
    loop k in child_order(doc, node):
        if node_shown(doc.nodes[k]):
            list = paint_within(doc, theme, face, measured, k, list, want, mine, mist, inner, inner_rad, ours)
    if clipping:
        list = push_cmd(list, SetClip(room, room_rad, node_id))
        # After the clip is given back, so the bar is never cut by the box
        # it belongs to.
        if node_bars(node):
            list = add_bar_for(doc, theme, measured, node_id, list)
    list

# The track and its thumb. The thumb is as tall a share of the track as
# the box is of the content, and sits as far down it as you have scrolled -
# which is the whole language of a scrollbar in one sentence.
define add_bar_for(doc: SemanticDocument, theme: Theme, measured: [Measured], node_id: number, into: DisplayList) -> DisplayList:
    node = doc.nodes[node_id]
    box = measured[node_id].rect
    reach = content_below(doc, measured, node_id, box)
    seen = to_whole(box.high)
    if reach <= seen or seen <= 0:
        return into
    style = style_of(theme, node)
    wide = 4.0
    # On the other side when the screen reads the other way, because a
    # scrollbar sits at the end of the line and the end has moved.
    x = if mirrored(doc) then box.x + 2.0 else box.x + box.wide - wide - 2.0
    tall = box.high - 4.0
    grip = tall * to_real(seen) / to_real(reach)
    least = 24.0
    high = if grip < least then least else grip
    away = to_real(node_scroll_y(node))
    span = to_real(reach - seen)
    raw = if span > 0.0 then away / span else 0.0
    # Clamped, so a scroll value the app has not yet caught up with can
    # never push the thumb outside its own track.
    frac = if raw < 0.0 then 0.0 else if raw > 1.0 then 1.0 else raw
    y = box.y + 2.0 + (tall - high) * frac
    track = push_cmd(into, DrawRoundRect(Rect{x: x, y: box.y + 2.0, wide: wide, high: tall}, bar_track(style), "2", node_id))
    push_cmd(track, DrawRoundRect(Rect{x: x, y: y, wide: wide, high: high}, bar_thumb(style), "2", node_id))

# The bar borrows the node's own colours: its border for the track, its
# text colour for the thumb. A scrollbar is chrome, and chrome that needs
# its own two theme entries per scrolling box is chrome nobody will set.
define bar_track(style: StyleRule) -> text:
    if style.border_colour is not "" then style.border_colour else "#2a2a2aff"

define bar_thumb(style: StyleRule) -> text:
    if style.fg_colour is not "" then style.fg_colour else "#6a6a6aff"

define paint_from(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured], node_id: number, into: DisplayList) -> DisplayList:
    node = doc.nodes[node_id]
    edit list = paint_one(doc, theme, face, measured, node_id, into, 100, node_name(doc.nodes[node_id]))
    clipping = node_clips(node)
    if clipping:
        list = push_cmd(list, SetClip(measured[node_id].rect, node_radius(node, style_of(theme, node), scale_now()), node_id))
    loop k in child_order(doc, node):
        if node_shown(doc.nodes[k]):
            list = paint_from(doc, theme, face, measured, k, list)
    # Back to whatever the parent had. Nesting a clip inside a clip is not
    # supported yet - the inner one wins and the outer is dropped - which is
    # honest for a single scissor rect and enough for a list in a panel.
    if clipping:
        list = push_cmd(list, SetClip(no_clip(), 0, node_id))
    list

# A colour on its way to where the document just put it. Only nodes with
# a name travel - everything else has no identity to remember and would
# be starting from nothing every frame anyway.
define arriving(who: text, what: text, colour: text) -> text:
    if who is "":
        return colour
    smooth_colour("{who}|{what}", colour)

# Taking the clip OFF. It has to be a box that could never be a real one,
# because a box of zero size is a perfectly good clip - it is what a
# folded section is - and saying that with the same value that means "no
# clip at all" let every collapsed thing paint its contents into the room
# around it.
# Two clips at once: what is inside both. `no_clip` on either side means
# that side is not asking for anything.
# Is this box entirely outside what can be seen? A box with no size answers
# no: it is not outside anything, it is simply not a box.
define hidden_by(what: Rect, room: Rect) -> truth:
    if what.wide <= 0.0 or what.high <= 0.0:
        return false
    seen = both_of(what, room)
    seen.wide <= 0.0 or seen.high <= 0.0

define both_of(a: Rect, b: Rect) -> Rect:
    if b.wide < 0.0 or b.high < 0.0:
        return a
    if a.wide < 0.0 or a.high < 0.0:
        return b
    x0 = if a.x > b.x then a.x else b.x
    y0 = if a.y > b.y then a.y else b.y
    x1 = if a.x + a.wide < b.x + b.wide then a.x + a.wide else b.x + b.wide
    y1 = if a.y + a.high < b.y + b.high then a.y + a.high else b.y + b.high
    Rect{x: x0, y: y0, wide: if x1 > x0 then x1 - x0 else 0.0, high: if y1 > y0 then y1 - y0 else 0.0}

# What the whole frame can see. Painting starts here rather than at "no clip
# at all", so anything that ended up off the screen is thrown away at the top
# of the walk instead of being handed to the painter to discard. It matters
# for exactly the things that are placed at a point rather than in the flow -
# three hundred nameplates of which sixty are in front of you.
define screen_of(doc: SemanticDocument, measured: [Measured]) -> Rect:
    if length(measured) is 0 or doc.root >= length(measured):
        return no_clip()
    measured[doc.root].rect

define no_clip() -> Rect:
    Rect{x: 0.0, y: 0.0, wide: 0.0 - 1.0, high: 0.0 - 1.0}

# A colour at a fraction of its own alpha. 100 leaves it exactly alone,
# which is the case for almost every node, so it costs nothing to ask.
define faded(colour: text, dim: number) -> text:
    if dim >= 100 or colour is "":
        return colour
    v = packed(colour)
    if v < 0:
        return colour
    unpacked(v // 256 * 256 + v % 256 * dim // 100)

define paint_one(doc: SemanticDocument, theme: Theme, face: Font, measured: [Measured], i: number, into: DisplayList, dim: number, whose: text) -> DisplayList:
    at_scale = scale_now()
    edit list = into
    node = doc.nodes[i]
    style = style_of(theme, node)
    m = measured[i]
    r = m.rect
    # What this node's look is remembered under. Its own name if it has
    # one, else its owner's plus what it IS - so a button's plate and the
    # words on it move together instead of one travelling while the other
    # jumps, which is the same state change happening two ways in one
    # control. Two labels of the same role inside one thing share a key
    # and always agree, because the same state is telling them both.
    # A node that states its OWN colour is not in a themed state, it is
    # holding a value - so it is not remembered and does not travel. Two
    # labels of one role inside one thing may share a key because the same
    # state tells them both; sixteen swatches of one role may not, because
    # each was handed a different colour and they would all end up the
    # last one.
    said_own = prop_val(node, "color") is not "" or prop_val(node, "ink") is not ""
    who = if said_own then "" else if node_name(node) is not "" then node_name(node) else if whose is not "" then "{whose}|{node.role.name}" else ""
    # A box with no width or no height draws nothing - not even its own
    # edge. A folded drawer is exactly that, and its border was the one
    # pixel of itself it left behind. Provenance = node index, so pick and
    # the display list agree on identity for free.
    if r.high > 0 and r.wide > 0:
        bg = faded(arriving(who, "bg", node_bg(node, style)), dim)
        rad = node_radius(node, style, at_scale)
        # A border is the box drawn twice: the edge colour full size, the
        # fill inset by the border width with a correspondingly tighter
        # radius. Two shaded boxes rather than a stroke primitive - the
        # ring falls out of the overlap and both edges stay smooth.
        # A shadow sits under everything else the node draws, nudged down
        # by half its blur - the direction light comes from in every UI
        # anyone has ever used.
        blur = big(prop_int(node, "shadow", style.shadow), at_scale)
        shade = faded(arriving(who, "shade", node_shadow_colour(node, style)), dim)
        if blur > 0 and shade is not "":
            drop = Rect{x: r.x, y: r.y + to_real(blur) / 2.0, wide: r.wide, high: r.high}
            list = push_cmd(list, DrawShadow(drop, shade, rad, blur, i))
        edge = faded(arriving(who, "edge", node_border_colour(node, style)), dim)
        bw = node_border(node, style, at_scale)
        ringed = bw > 0 and edge is not ""
        if ringed:
            list = push_box(list, r, edge, node_corners(node, style, 0, at_scale), i)
        inner = if ringed then inset(r, bw) else r
        if bg is not "" and prop_val(node, "ring") is "" and prop_val(node, "nine") is "":
            list = push_box(list, inner, bg, node_corners(node, style, if ringed then bw else 0, at_scale), i)
        # `icon: name` draws a named vector icon, sized to the smaller
        # side of the node's box. Same idea as `image`, but the art comes
        # from the icon set rather than from a file on disk.
        # `ring: <share>` - a radial meter. The role's own colour paints
        # the whole circle as the track, the ink paints the share of it
        # that is filled, and whatever text the node has still sits in the
        # middle of it. One node, and the document says a percentage
        # rather than an angle.
        share = prop_val(node, "ring")
        if share is not "":
            side = if r.wide < r.high then r.wide else r.high
            outer = to_whole(side) // 2
            thick = big(prop_int(node, "thick", 8), at_scale)
            mid = Point{x: r.x + r.wide / 2.0, y: r.y + r.high / 2.0}
            track = faded(arriving(who, "ringbg", node_bg(node, style)), dim)
            if track is not "":
                list = push_cmd(list, DrawArc(mid, outer, thick, 0, 360, track, i))
            part = number_in(share)
            sweep = if part > 100 then 360 else if part < 0 then 0 else part * 360 // 100
            if sweep > 0:
                list = push_cmd(list, DrawArc(mid, outer, thick, 0, sweep, faded(arriving(who, "fg", node_fg(node, style)), dim), i))
        # `shape: "0,1000 200,600 ..."` - a filled outline in parts per
        # thousand of this node's own box, so it is the same shape at any
        # size and the document never touches a pixel. A chart, a gauge
        # needle, a damage cone: the one thing rectangles could not do.
        poly = prop_val(node, "shape")
        if poly is not "":
            list = push_cmd(list, DrawPath(in_box(poly, r), faded(arriving(who, "fg", node_fg(node, style)), dim), i))
        ico = prop_val(node, "icon")
        if ico is not "":
            side = if r.wide < r.high then to_whole(r.wide) else to_whole(r.high)
            # An icon takes the node's ink, the same way its words do. A
            # mark that can only be one colour can only mean one thing.
            list = push_cmd(list, DrawIcon(Point{x: r.x, y: r.y}, ico, side, faded(arriving(who, "fg", node_fg(node, style)), dim), i))
        # `image: name` fills the node's box with a picture the host
        # resolves - the box is the frame, the art is the content.
        # `nine: <picture>` with `slice: N` skins the box from a picture
        # whose corners keep their size however big the box gets. A frame
        # with a carved border is the whole of game UI art, and neither a
        # stretched picture nor a rounded rect can be one.
        skin = prop_val(node, "nine")
        if skin is not "":
            list = push_cmd(list, DrawNine(r, skin, big(prop_int(node, "slice", 8), at_scale), "", "alpha", i))
        img = prop_val(node, "image")
        if img is not "":
            list = push_cmd(list, DrawImage(Point{x: r.x, y: r.y}, img, to_whole(r.wide), to_whole(r.high), "", "alpha", i))
        # A leaf's own label: `align`/`justify: center` on a node
        # with text and no children centers the LINE in its box -
        # the same words that center children, applied to the words.
        if node_text(node) is not "":
            pad = node_pad(node, style, at_scale)
            size = node_size(node, style, at_scale)
            room = to_whole(r.wide) - pad * 2
            lines = if node_wraps(node) and room > 0:
                wrap_text(node_text(node), size, face, room)
            else:
                [node_text(node)]
            shown_lines = if node_trims(node) then [trim_to(node_text(node), size, face, to_whole(r.wide) - pad * 2)] else lines
            list = push_lines(list, shown_lines, r, pad, size, faded(arriving(who, "fg", node_fg(node, style)), dim), face, node, i, mirrored(doc))
    list

# Picking walks the TREE in the same order paint does - parent, then
# children - and keeps the LAST hit, so whatever was drawn on top is what
# answers. Walking the node ARRAY instead made the answer depend on where a
# node happened to sit in storage: a document that lists its root last had
# the root, which covers the whole window, win every point. Nothing was
# clickable and nothing lit up, because every pointer got the root back.
define pick_walk(doc: SemanticDocument, theme: Theme, measured: [Measured], node_id: number, x: number, y: number, so_far: text) -> text:
    node = doc.nodes[node_id]
    edit best = so_far
    if rect_contains(measured[node_id].rect, Point{x: x, y: y}):
        d = node_do(node)
        if d is not "":
            best = d
        else:
            style = style_of(theme, node)
            painted = node_bg(node, style) is not "" or node_text(node) is not "" or prop_val(node, "image") is not ""
            # A painted child INSIDE a control does not steal its click. A
            # button is its face, its label and its icon; every one of those
            # is painted, and every one of them sits on top of the node that
            # carries the `do:`. Only claim the click as mute when nothing
            # on the way down claimed it for real - the nearest bound
            # ancestor keeps it, the way an event finds its handler.
            if painted and best is "":
                best = "\{mute\}"
    loop k in child_order(doc, node):
        if node_shown(doc.nodes[k]):
            best = pick_walk(doc, theme, measured, k, x, y, best)
    best

# Lay the lines down, each centred or flushed the same way one line would
# have been. One DrawText per line - the painter has no idea text wraps and
# does not need to.
# The caret and the selection, drawn by the framework rather than by the
# document. A document CAN put a caret between two text nodes while there
# is one line - that is how the single-line field does it - but the moment
# the text wraps it cannot, because it has no idea where the lines break.
# Only the thing that broke them does.
#
# `caret: <byte>` says where the caret is, `anchor: <byte>` the other end
# of the selection. Both are byte offsets into the node's own text, which
# is what veil_edit hands out.
define push_marks(list: DisplayList, lines: [text], r: Rect, pad: number, size: number, face: Font, node: Node, src: number, lit: truth) -> DisplayList:
    at_c = prop_int(node, "caret", 0 - 1)
    if at_c < 0:
        return list
    an = prop_int(node, "anchor", at_c)
    from = if an < at_c then an else at_c
    to = if an > at_c then an else at_c
    lh = line_high(size, face)
    edit out = list
    edit seen = 0
    edit n = 0
    loop line in lines:
        b = bytes_of(line)
        len_of = bytes_count(b)
        # What of this line the selection covers, in its own bytes.
        lo = if from - seen < 0 then 0 else if from - seen > len_of then len_of else from - seen
        hi = if to - seen < 0 then 0 else if to - seen > len_of then len_of else to - seen
        if hi > lo:
            x0 = to_real(text_size(text_of(bytes_part(b, 0, to_whole(lo))), size, face).wide)
            x1 = to_real(text_size(text_of(bytes_part(b, 0, to_whole(hi))), size, face).wide)
            plate = Rect{x: r.x + to_real(pad) + x0, y: r.y + to_real(pad + n * lh), wide: x1 - x0, high: to_real(lh)}
            out = push_cmd(out, DrawRect(plate, "#2f5aa8ff", src))
        seen = seen + len_of + 1
        n = n + 1
    # --- text on its way in -------------------------------------------------
    #
    # Typing Japanese means typing "nihon" and getting a choice of ways to
    # write it; the letters on their way to becoming a word are UNDERLINED
    # while they are still undecided. Without that the field looks like it
    # already accepted them, and there is no way to see what the next key
    # will replace.
    #
    # The composing text sits in the node's own text, so it measures and
    # wraps like everything else; `compose_from` and `compose_to` are byte
    # offsets into it, the same as `caret` and `anchor`. The platform is
    # what knows a composition is happening - Windows says so with its IME
    # messages, a browser with compositionstart - so the app carries the
    # two numbers across and veil draws the line.
    c_from = prop_int(node, "compose_from", 0 - 1)
    c_to = prop_int(node, "compose_to", 0 - 1)
    if c_from >= 0 and c_to > c_from:
        edit under_seen = 0
        edit under_n = 0
        loop line in lines:
            ub = bytes_of(line)
            u_len = bytes_count(ub)
            u_lo = if c_from - under_seen < 0 then 0 else if c_from - under_seen > u_len then u_len else c_from - under_seen
            u_hi = if c_to - under_seen < 0 then 0 else if c_to - under_seen > u_len then u_len else c_to - under_seen
            if u_hi > u_lo:
                ux0 = to_real(text_size(text_of(bytes_part(ub, 0, to_whole(u_lo))), size, face).wide)
                ux1 = to_real(text_size(text_of(bytes_part(ub, 0, to_whole(u_hi))), size, face).wide)
                rule = Rect{x: r.x + to_real(pad) + ux0, y: r.y + to_real(pad + under_n * lh + lh) - 2.0, wide: ux1 - ux0, high: 1.0}
                out = push_cmd(out, DrawRect(rule, "#f2f2f2ff", src))
            under_seen = under_seen + u_len + 1
            under_n = under_n + 1
    # The caret itself, on the line it belongs to, and only when it is lit
    # - a caret that never blinks reads as a stuck one.
    if lit:
        spot = caret_spot(node_text(node), size, face, to_whole(r.wide) - pad * 2, at_c)
        bar = Rect{x: r.x + to_real(pad) + spot.wide, y: r.y + to_real(pad) + spot.high, wide: 2.0, high: to_real(lh)}
        out = push_cmd(out, DrawRect(bar, "#f2f2f2ff", src))
    out

# One line drawn as its coloured pieces, each starting where the last one
# ended. The pieces are measured with the same engine that draws them, so
# a colour change costs nothing in position.
define push_runs(list: DisplayList, runs: [text], x0: number, y: number, ink: text, size: number, face: Font, src: number) -> DisplayList:
    edit out = list
    edit x = x0
    edit i = 0
    loop:
        if i + 1 >= length(runs):
            break
        paint = if runs[i] is "" then ink else runs[i]
        piece = runs[i + 1]
        out = push_cmd(out, DrawText(Point{x: x, y: y}, piece, paint, size, src))
        x = x + to_real(text_size(piece, size, face).wide)
        i = i + 2
    out

define push_lines(list: DisplayList, lines: [text], r: Rect, pad: number, size: number, ink: text, face: Font, node: Node, src: number, rtl: truth) -> DisplayList:
    lh = line_high(size, face)
    block = length(lines) * lh
    lone = length(node.children) is 0
    centred = prop_val(node, "align") is "center" and lone
    # A line pushed to the far side. `align` means the cross axis for a box
    # with children and the line's own side for one without, which is the
    # same word meaning the same thing at two scales.
    # A line ends where the reading does. On a screen that reads the other
    # way that is the LEFT edge for the words and the right edge for where
    # the line starts - so a label narrower than its box sits against the
    # right of it, without any document having to say so.
    ended = (prop_val(node, "align") is "end" or rtl) and lone and not centred
    middled = prop_val(node, "justify") is "center" and lone
    # Padding that does not fit is not a licence to draw outside the box.
    # A box shorter than its own padding used to put its line BELOW itself,
    # which reads as a broken renderer rather than as a tight box - so when
    # the block will not clear the bottom edge, it centres instead.
    asked = if middled then r.y + (r.high - to_real(block)) / 2.0 else r.y + to_real(pad)
    top = if asked + to_real(block) > r.y + r.high then r.y + (r.high - to_real(block)) / 2.0 else asked
    # `edge: <colour>` on a text node draws the line four times around
    # itself first. Text over a battlefield, a photograph or a gradient is
    # unreadable without it, and a game has nothing BUT those - one colour
    # that works on every background does not exist.
    rim = prop_val(node, "ink_edge")
    # No ink is no text. An empty colour reaching the painter is read as
    # hex that is not there, and the letters come out whatever the bytes
    # past the end happened to be - which is how a label being faded away
    # turned bright pink on its way out.
    edit out = push_marks(list, lines, r, pad, size, face, node, src, prop_val(node, "lit") is "1")
    # The caret and the selection have colours of their own, so they are
    # drawn either way; the LINES are not drawn without ink to draw them
    # in. An empty colour reaching the painter is read as hex that is not
    # there, and the letters come out whatever the bytes past the end
    # happened to be - which is how a label being faded away turned
    # bright pink on its way out.
    if ink is "":
        return out
    edit n = 0
    loop line in lines:
        ts = text_size(line, size, face)
        # What the line READS as: the colour markers are placement, not
        # letters, so the outline and the plain draw both take them out.
        flat = plain_of(line)
        x = if centred then r.x + (r.wide - to_real(ts.wide)) / 2.0 else if ended then r.x + r.wide - to_real(ts.wide) - to_real(pad) else r.x + to_real(pad)
        y = top + to_real(n * lh)
        if rim is not "":
            out = push_cmd(out, DrawText(Point{x: x - 1.0, y: y}, flat, rim, size, src))
            out = push_cmd(out, DrawText(Point{x: x + 1.0, y: y}, flat, rim, size, src))
            out = push_cmd(out, DrawText(Point{x: x, y: y - 1.0}, flat, rim, size, src))
            out = push_cmd(out, DrawText(Point{x: x, y: y + 1.0}, flat, rim, size, src))
        out = if has_runs(bytes_of(line), bytes_count(bytes_of(line))):
            push_runs(out, runs_of(line), x, y, ink, size, face, src)
        else:
            push_cmd(out, DrawText(Point{x: x, y: y}, flat, ink, size, src))
        n = n + 1
    out

# The click a UI claims x[y]: the topmost hit node's `do:` name;
# "\{mute\}" when a PAINTED node without a do: takes the click (a card
# under a button still blocks the world); "" when the UI is air there -
# scaffolding panels with no paint and no words claim nothing, so the
# game underneath keeps its clicks.
public define pick_spoken(doc: SemanticDocument, theme: Theme, face: Font, box: Rect, x: number, y: number) -> text:
    if length(doc.nodes) is 0:
        return ""
    placed = layout_in(doc, theme, face, box)
    # Highest layer first: what is drawn on top is what answers, and the
    # search stops as soon as a layer claims the point.
    edit layer = highest_layer(doc)
    edit spoken = ""
    loop:
        if layer < 0 or spoken is not "":
            break
        spoken = pick_layer(doc, theme, placed, doc.root, x, y, "", layer, 0)
        layer = layer - 1
    kept(spoken)

define pick_layer(doc: SemanticDocument, theme: Theme, measured: [Measured], node_id: number, x: number, y: number, so_far: text, want: number, inherited: number) -> text:
    node = doc.nodes[node_id]
    # `pass: 1` - painted, but the pointer goes straight through it, and
    # through everything inside it. The thing under your hand while you
    # drag, and the mark showing where it will land, are both drawn ON TOP
    # of what the pointer is asking about: without this they answer
    # instead of it, so the mark appears, the pointer lands in the mark,
    # the mark says "nothing here" and it goes out again - once a frame,
    # which is a strobe rather than a drag.
    if node_passes(node) or node_off(node):
        return so_far
    mine = if node_layer(node) > inherited then node_layer(node) else inherited
    edit best = so_far
    if mine is want and rect_contains(measured[node_id].rect, Point{x: x, y: y}):
        d = node_do(node)
        if d is not "":
            best = d
        else:
            style = style_of(theme, node)
            painted = node_bg(node, style) is not "" or node_text(node) is not "" or prop_val(node, "image") is not ""
            if painted and best is "":
                best = "\{mute\}"
    loop k in child_order(doc, node):
        if node_shown(doc.nodes[k]):
            best = pick_layer(doc, theme, measured, k, x, y, best, want, mine)
    best

# --- who gets the input -----------------------------------------------------
#
# A game has to ask three questions before it acts on anything, and it has to
# ask them of the UI, because the UI is on top:
#
#     if not over_ui(doc, dress, placed, mx, my):
#         shoot()
#     if not taking_keys(doc):
#         move(w, a, s, d)
#     if not holding_pad(doc):
#         swing_camera(rx, ry)
#
# Getting this wrong is the oldest bug in games with UI: you click a button
# and your character shoots the wall behind it, or you type "west" in chat
# and walk west. Every one of the three is derived from the document that is
# already on screen, so none of them can drift out of step with what is drawn.

# Is the pointer over anything the UI drew? Not just over something you can
# press - a panel is as solid as a button, and a click on the middle of a
# window is not a click on the world. Nodes marked `pass: 1` are see-through
# to the pointer and so is empty space between things.
public define over_ui(doc: SemanticDocument, theme: Theme, placed: [Measured], x: number, y: number) -> truth:
    pick_placed(doc, theme, placed, x, y) is not ""

# Is somebody typing? A field with a caret in it has the keyboard, and WASD
# means four letters until it does not.
public define taking_keys(doc: SemanticDocument) -> truth:
    if length(doc.nodes) is 0:
        return false
    typing_below(doc, doc.root)

# Down the TREE, not along the array. The array is storage - it can hold a
# branch that was built and then not used, and a field nobody put on the
# screen is not a field anybody is typing in.
define typing_below(doc: SemanticDocument, node_id: number) -> truth:
    node = doc.nodes[node_id]
    if not node_shown(node):
        return false
    if prop_int(node, "caret", 0 - 1) >= 0:
        return true
    edit found = false
    loop k in node.children:
        if typing_below(doc, k):
            found = true
    found

# Is the UI holding the controller? Anything on a raised layer - a dialog, a
# menu, an inventory over the world - means the stick is driving the ring and
# not the camera. A screen with nothing raised leaves the pad to the game.
public define holding_pad(doc: SemanticDocument) -> truth:
    highest_layer(doc) > 0

# Hit-test against the host-box layout (see layout_in). -1 = miss.
define pick_id_walk(doc: SemanticDocument, measured: [Measured], node_id: number, x: number, y: number, so_far: number) -> number:
    edit best = so_far
    if rect_contains(measured[node_id].rect, Point{x: x, y: y}):
        best = node_id
    loop k in child_order(doc, doc.nodes[node_id]):
        if node_shown(doc.nodes[k]):
            best = pick_id_walk(doc, measured, k, x, y, best)
    best

public define pick_node_in(doc: SemanticDocument, theme: Theme, face: Font, box: Rect, x: number, y: number) -> number:
    if length(doc.nodes) is 0:
        0 - 1
    else:
        pick_id_walk(doc, layout_in(doc, theme, face, box), doc.root, x, y, 0 - 1)

# Hit-test against the same layout the renderer drew. -1 = miss.
# Last match wins so later (overlapping) nodes sit "on top".
public define pick_node(doc: SemanticDocument, theme: Theme, face: Font, x: number, y: number) -> number:
    if length(doc.nodes) is 0:
        0 - 1
    else:
        pick_id_walk(doc, layout(doc, theme, face), doc.root, x, y, 0 - 1)
