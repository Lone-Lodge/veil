# veil_page - a display list painted straight into a page.
#
# The other way out of veil is veil_web, which turns a DisplayList into JSON
# for someone else to read. That costs a serialise on this side and a parse
# on the other, every frame, for a list that is six hundred commands long.
#
# This is the seam without the middle: the whole frame as two blocks of
# numbers and ONE call. On the wasm backend an `external define` becomes an
# `env.*` import, so the page supplies that one function and IS the
# renderer. Nothing is encoded and nothing is parsed.
#
# It began as eleven host functions, one per draw command, called as the
# list was walked. Measured, those hundred and fifty crossings and the
# strings they carried were most of what a frame cost once the layout was
# cheap - clipping the canvas down to one pixel only took a tenth of a
# millisecond off, so it was never the drawing. So they are gone, and what
# is left is the block below.


# --- the whole frame, as numbers --------------------------------------------
#
# Two blocks and one call.
#
#   cmds   twelve numbers a command, always in the same places
#   words  the letters, one byte to a number, pointed into by offset
#
# A colour is `#rrggbbaa` worked out into a single number here rather than
# read as text there; the page keeps a table from that number to whatever it
# needs, and builds each one once ever. A radius is four numbers. What still
# crosses as letters is the words themselves, which are words.
#
# Twelve wide and fixed is not tidiness: it is one instance of a GPU draw
# call. The page's card renderer reads this block straight into instances
# and draws the screen with one.

use ori_geometry
use ori_display
use veil_motion
use veil_resolver
use text
use list

external define page_frame(cmds: [int], count: int, words: [int]) -> int

# kind: 1 rect  2 shadow  3 clip  4 text  5 icon  6 arc  7 path  8 image
#       9 nine  10 sprite
#   0 kind | 1 x | 2 y | 3 w | 4 h | 5 colour | 6..9 four more | 10,11 words
#
# For text the four more are: 6 size, 7 the name of the line (see say_out).
#
# A colour of -1 means "the letters at 11 say it" - a gradient. -2 means do
# not paint at all, and the page never has to look.
public define pack_page(list: DisplayList) -> number:
    n = length(list.commands)
    if n is 0:
        return 0
    edit cmds = filled(n * 12, 0)
    edit words = filled(word_room(list) + 1, 0)
    edit at = 0
    edit wat = 0
    loop cmd in list.commands:
        wat = pack_one(cmds, words, at, wat, cmd)
        at = at + 12
    page_frame(cmds, n, words)

# How many letters the whole frame carries, counted before anything is
# written so both blocks can be made once and written in place.
define word_room(list: DisplayList) -> number:
    edit room = 0
    loop cmd in list.commands:
        room = room + words_of(cmd)
    room

define words_of(cmd: DrawCmd) -> number:
    choose cmd:
        DrawRect(r, colour, src) then say_room(colour)
        DrawRoundRect(r, colour, corners, src) then say_room(colour)
        DrawShadow(r, colour, rad, blur, src) then say_room(colour)
        SetClip(r, rad, src) then 0
        DrawText(p, content, colour, size, src) then room_for(content) + say_room(colour)
        DrawIcon(p, icon, size, colour, src) then room_for(icon) + say_room(colour)
        DrawArc(mid, outer, thick, from_deg, to_deg, colour, src) then say_room(colour)
        DrawPath(points, colour, src) then room_for(points) + say_room(colour)
        DrawImage(p, path, w, h, tint, blend, src) then room_for(path)
        DrawNine(r, path, corner, tint, blend, src) then room_for(path)
        DrawSprite(p, path, scale, src) then room_for(path)

# A colour only needs letters when it is not a plain `#rrggbbaa`.
define say_room(colour: text) -> number:
    if packed(colour) < 0 and length(colour) > 1 then room_for(colour) else 0

define room_for(t: text) -> number:
    bytes_count(bytes_of(t)) + 1

# One command. Answers where its letters ended, so the next one knows where
# to start.
define pack_one(cmds: [number], words: [number], at: number, wat: number, cmd: DrawCmd) -> number:
    choose cmd:
        DrawRect(r, colour, src) then box_out(cmds, words, at, wat, 1, r, colour, 0, 0, 0, 0)
        DrawRoundRect(r, colour, corners, src) then round_out(cmds, words, at, wat, r, colour, corners)
        DrawShadow(r, colour, rad, blur, src) then box_out(cmds, words, at, wat, 2, r, colour, rad, blur, 0, 0)
        SetClip(r, rad, src) then box_out(cmds, words, at, wat, 3, r, "", rad, 0, 0, 0)
        DrawText(p, content, colour, size, src) then say_out(cmds, words, at, wat, 4, p, content, colour, size)
        DrawIcon(p, icon, size, colour, src) then say_out(cmds, words, at, wat, 5, p, icon, colour, size)
        DrawArc(mid, outer, thick, from_deg, to_deg, colour, src) then arc_out(cmds, words, at, wat, mid, outer, thick, from_deg, to_deg, colour)
        DrawPath(points, colour, src) then say_out(cmds, words, at, wat, 7, no_point(), points, colour, 0)
        DrawImage(p, path, w, h, tint, blend, src) then art_out(cmds, words, at, wat, 8, p.x, p.y, to_real(w), to_real(h), path, 0)
        DrawNine(r, path, corner, tint, blend, src) then art_out(cmds, words, at, wat, 9, r.x, r.y, r.wide, r.high, path, corner)
        DrawSprite(p, path, scale, src) then art_out(cmds, words, at, wat, 10, p.x, p.y, 0.0, 0.0, path, scale)

define no_point() -> Point:
    Point{x: 0.0, y: 0.0}

define box_out(cmds: [number], words: [number], at: number, wat: number, kind: number, r: Rect, colour: text, a: number, b: number, c: number, d: number) -> number:
    edit out = cmds
    out = set(out, at, kind)
    out = set(out, at + 1, to_whole(r.x))
    out = set(out, at + 2, to_whole(r.y))
    out = set(out, at + 3, to_whole(r.wide))
    out = set(out, at + 4, to_whole(r.high))
    out = set(out, at + 6, a)
    out = set(out, at + 7, b)
    out = set(out, at + 8, c)
    out = set(out, at + 9, d)
    out = set(out, at + 10, 0 - 1)
    ink_out(cmds, words, at, wat, colour)

define round_out(cmds: [number], words: [number], at: number, wat: number, r: Rect, colour: text, corners: text) -> number:
    four = split(corners, " ")
    one = number_in(corners)
    tl = if length(four) >= 4 then number_in(four[0]) else one
    tr = if length(four) >= 4 then number_in(four[1]) else one
    br = if length(four) >= 4 then number_in(four[2]) else one
    bl = if length(four) >= 4 then number_in(four[3]) else one
    box_out(cmds, words, at, wat, 1, r, colour, tl, tr, br, bl)

# A line also says what line it is. The same words are drawn every single
# frame, and a reader that keeps a finished row of letters per name never
# has to read the letters again. The name is what the slot store already
# hashes text with, and the length sits at the front of the word block, so
# a reader that checks both cannot serve one line's letters for another's.
define say_out(cmds: [number], words: [number], at: number, wat: number, kind: number, p: Point, content: text, colour: text, size: number) -> number:
    edit out = cmds
    out = set(out, at, kind)
    out = set(out, at + 1, to_whole(p.x))
    out = set(out, at + 2, to_whole(p.y))
    out = set(out, at + 6, size)
    if kind is 4:
        out = set(out, at + 7, text_hash(content))
    after = letters_out(cmds, words, at, 10, wat, content)
    ink_out(cmds, words, at, after, colour)

define arc_out(cmds: [number], words: [number], at: number, wat: number, mid: Point, outer: number, thick: number, from_deg: number, to_deg: number, colour: text) -> number:
    edit out = cmds
    out = set(out, at, 6)
    out = set(out, at + 1, to_whole(mid.x))
    out = set(out, at + 2, to_whole(mid.y))
    out = set(out, at + 6, outer)
    out = set(out, at + 7, thick)
    out = set(out, at + 8, from_deg)
    out = set(out, at + 9, to_deg)
    out = set(out, at + 10, 0 - 1)
    ink_out(cmds, words, at, wat, colour)

define art_out(cmds: [number], words: [number], at: number, wat: number, kind: number, x: number, y: number, w: number, h: number, path: text, extra: number) -> number:
    edit out = cmds
    out = set(out, at, kind)
    out = set(out, at + 1, to_whole(x))
    out = set(out, at + 2, to_whole(y))
    out = set(out, at + 3, to_whole(w))
    out = set(out, at + 4, to_whole(h))
    out = set(out, at + 5, 0 - 2)
    out = set(out, at + 6, extra)
    out = set(out, at + 11, 0 - 1)
    letters_out(cmds, words, at, 10, wat, path)

# A colour goes in as a number when it can, and as letters when it cannot.
define ink_out(cmds: [number], words: [number], at: number, wat: number, colour: text) -> number:
    edit out = cmds
    if length(colour) < 2:
        out = set(out, at + 5, 0 - 2)
        out = set(out, at + 11, 0 - 1)
        return wat
    packed_now = packed(colour)
    out = set(out, at + 5, packed_now)
    if packed_now >= 0:
        out = set(out, at + 11, 0 - 1)
        return wat
    letters_out(cmds, words, at, 11, wat, colour)

# Letters into the word block, and where they start into the command.
define letters_out(cmds: [number], words: [number], at: number, slot: number, wat: number, t: text) -> number:
    edit out = cmds
    b = bytes_of(t)
    n = bytes_count(b)
    if n is 0:
        out = set(out, at + slot, 0 - 1)
        return wat
    edit w = words
    w = set(w, wat, n)
    loop i in 0 until n:
        w = set(w, wat + 1 + i, byte_at(b, i))
    out = set(out, at + slot, wat)
    wat + n + 1
