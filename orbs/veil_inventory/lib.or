# veil_inventory — feature-showcase demo.
#
# Rust kept this at 690 lines. The Orion port focuses on the DATA
# the demo authors — items, columns, filters — and lets the resolver
# render them through the same Veil pipeline as everything else.
#
# Exercises scroll areas + scrollbar, right-click context menu,
# hover/focus/press, selection, and keyboard navigation — all on a
# pure Document IR.

use veil_document
use veil_role

# One inventory entry. Quantity is `0...9999` so the compiler packs
# it as `u16` (range types, §8) — 65× less RAM for big inventories
# than a Rust BTreeMap of i64s.
pub data Item: name: Text, quantity: 0...9999, rarity: Text, weight_grams: int

pub data Inventory: items: [Item], selected_index: int

pub fn empty_inventory() -> Inventory:
    Inventory{items: [], selected_index: 0}

# Build the demo's canonical item list — 5 entries that exercise the
# rarity colours + scroll behaviour without flooding the layout.
pub fn demo_inventory() -> Inventory:
    Inventory{items: [Item{name: "Sword of dawn", quantity: 1, rarity: "epic", weight_grams: 1800}, Item{name: "Health potion", quantity: 12, rarity: "common", weight_grams: 50}, Item{name: "Map fragment", quantity: 3, rarity: "rare", weight_grams: 5}, Item{name: "Iron ore", quantity: 47, rarity: "common", weight_grams: 200}, Item{name: "Phoenix feather", quantity: 1, rarity: "legendary", weight_grams: 1}], selected_index: 0}

pub fn select(inventory: Inventory, index: int) -> Inventory:
    Inventory{items: inventory.items, selected_index: index}

# Move selection by +1/-1, clamped to the item count. Hooks into the
# keyboard arrow keys at the web shell.
pub fn move_selection(inventory: Inventory, delta: int) -> Inventory:
    new_index = inventory.selected_index + delta
    clamped = clamp_index(new_index, item_count(inventory))
    Inventory{items: inventory.items, selected_index: clamped}

fn item_count(inventory: Inventory) -> int:
    mut count = 0
    for _item in inventory.items:
        count = count + 1
    count

fn clamp_index(value: int, max_exclusive: int) -> int:
    if value < 0:
        0
    else:
        if value >= max_exclusive:
            max_exclusive - 1
        else:
            value
