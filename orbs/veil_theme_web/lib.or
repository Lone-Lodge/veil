# veil_theme_web — shared design-system theme for every web demo.
#
# Rust kept this at 201 lines: dozens of (role, Vis) → style mappings,
# a few named palettes, the per-state visibility table. Orion just
# declares the rule list — each demo can swap palettes with a one-
# value change.

use veil_theme
use veil_role

# Default web theme — six rules cover the canonical roles. A real app
# adds rows for its custom roles; the resolver picks the last match.
public define default_theme() -> Theme:
    Theme{rules: [StyleRule{role_name: "button", padding: 12, gap: 8, fg_colour: "#fff", bg_colour: "#0ea5e9", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "heading", padding: 0, gap: 16, fg_colour: "#0f172a", bg_colour: "", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "text", padding: 0, gap: 8, fg_colour: "#334155", bg_colour: "", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "panel", padding: 16, gap: 12, fg_colour: "#0f172a", bg_colour: "#f8fafc", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "card", padding: 16, gap: 12, fg_colour: "#0f172a", bg_colour: "#fff", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "input", padding: 8, gap: 0, fg_colour: "#0f172a", bg_colour: "#fff", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}]}

# Dark variant — same role set, inverted palette. Demos toggle this
# from the JS shell via a single fn call.
public define dark_theme() -> Theme:
    Theme{rules: [StyleRule{role_name: "button", padding: 12, gap: 8, fg_colour: "#0f172a", bg_colour: "#38bdf8", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "heading", padding: 0, gap: 16, fg_colour: "#f1f5f9", bg_colour: "", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "text", padding: 0, gap: 8, fg_colour: "#cbd5e1", bg_colour: "", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "panel", padding: 16, gap: 12, fg_colour: "#f1f5f9", bg_colour: "#020617", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "card", padding: 16, gap: 12, fg_colour: "#f1f5f9", bg_colour: "#0f172a", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}, StyleRule{role_name: "input", padding: 8, gap: 0, fg_colour: "#f1f5f9", bg_colour: "#1e293b", direction: "", radius: 0, size: 0, border: 0, border_colour: ""}]}
