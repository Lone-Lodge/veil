# veil_devui — the engine dev overlay, built on the veil display seam.
# A dark panel of text rows in the top-left corner; games append it to
# their display list when dev mode is on. Text renders through the
# backend's built-in glyph font.

use veil_display
use veil_geometry

pub fn devui_overlay(list: DisplayList, lines: [Text]) -> DisplayList:
    if len(lines) == 0:
        list
    else:
        overlay_rows(list, lines)

fn overlay_rows(list: DisplayList, lines: [Text]) -> DisplayList:
    n = len(lines)
    panel = Rect{x: 6, y: 6, width: 230, height: n * 18 + 12}
    mut out = push_cmd(list, DrawRect(panel, "black"))
    for i in 0..<n:
        out = push_cmd(out, DrawText(Point{x: 14, y: 14 + i * 18}, line_at(lines, i), "green", 12))
    out

fn line_at(lines: [Text], i: int) -> Text:
    at(lines, i)
