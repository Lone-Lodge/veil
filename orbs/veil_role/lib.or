# veil_role - semantic labels.
#
# Open + extensible: a role is just a string, looked up in the
# theme. No closed enum; user themes add roles freely.

public type Role: name: text

public define role(name: text) -> Role:
    Role{name: name}

public define role_button() -> Role = Role{name: "button"}
public define role_heading() -> Role = Role{name: "heading"}
public define role_text() -> Role = Role{name: "text"}
