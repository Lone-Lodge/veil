# veil_document — the SemanticDocument IR.
#
# A node is a role + props + children. No widget classes, no
# styling at the node level — those come from the theme via the
# resolver. The 656-line Rust crate collapses to this shape.

use veil_role
use text

public type NodeProp: key: text, content: text
public type Node: role: Role, props: [NodeProp], children: [int]

public type SemanticDocument: root: int, nodes: [Node]

# The `do:` a node carries - its click's spoken name. "" when mute.
public define node_do(node: Node) -> text:
    edit act = ""
    loop prop in node.props:
        if prop.key == "do":
            act = prop.content
    act

# Whether any node in the document speaks this `do:` name.
public define doc_speaks(doc: SemanticDocument, name: text) -> truth:
    edit found = false
    loop node in doc.nodes:
        if node_do(node) == name:
            found = true
    found

public define empty_doc() -> SemanticDocument:
    SemanticDocument{root: 0, nodes: []}

# --- has anything changed? -------------------------------------------------
# There was a doc_mark here: a fingerprint over every role, prop and child,
# compared frame to frame so an identical screen could skip resolving.
#
# It was four times SLOWER than the work it was avoiding. Walking every
# byte of every prop of a few hundred nodes in Orion costs more than
# measuring the text and handing the sprites over, and the gallery went
# from 13% of a core to 61%. Measured, not guessed, which is the only
# reason it is gone rather than tuned.
#
# What actually works is far simpler and is what every immediate-mode UI
# does: draw when there is INPUT or something is ANIMATING, and idle
# otherwise. Both are things the app already knows without being asked -
# no hashing, no dirty flags to forget to set.
