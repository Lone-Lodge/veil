# veil_theme — design system as data.
#
# A theme is a flat list of (role, style) entries. The resolver
# walks it deterministically — order matters, last-write wins.

use veil_role
use veil_token

# radius: corner rounding in px, 0 = square. size: text size in px, 0 =
# "no opinion", which the resolver reads as its 13px body default. Both used
# to live only as per-node props, so a document had to carry `radius: 7` and
# `size: 12` - a document saying how a thing LOOKS, which is the theme's job.
# A node prop still wins where one thing genuinely differs.
public type StyleRule: role_name: text, padding: int, gap: int, fg_colour: text, bg_colour: text, direction: text, radius: int, size: int, border: int, border_colour: text, shadow: int, shadow_colour: text

public type Theme: rules: [StyleRule]

public define empty_theme() -> Theme:
    Theme{rules: []}

# direction: "" or "column" = children stack vertically (the default).
# direction: "row" = children flow left-to-right on the same y.
public define lookup_style(theme: Theme, role: Role) -> StyleRule:
    lookup_state(theme, role, "")

# A role in a STATE: hovered, open, focused, whatever the app calls it.
# The rule is looked up as "role:state" and falls back to plain "role", so
# a theme only spells out the states it actually changes.
#
#     rule("item", ...)          the resting look
#     rule("item:lit", ...)      the same thing under the pointer
#
# Without this a theme needs a separate ROLE per state - item, item_lit,
# item_on - and the document has to pick the look by name, which is exactly
# the thing the document is not supposed to know.
public define lookup_state(theme: Theme, role: Role, state: text) -> StyleRule:
    # Most nodes are in no particular state, and building "role:state" for
    # them - a string interpolation per node, in both the measure pass and
    # the placement pass - was a real slice of every frame. Ask for the
    # plain rule without ever composing a name.
    if state is "":
        return plain_rule(theme, role.name)
    want = "{role.name}:{state}"
    edit found = nothing_rule(role.name)
    edit exact = false
    loop rule in theme.rules:
        if rule.role_name is role.name and not exact:
            found = rule
        if rule.role_name is want:
            found = rule
            exact = true
    found

define plain_rule(theme: Theme, name: text) -> StyleRule:
    loop rule in theme.rules:
        if rule.role_name is name:
            return rule
    nothing_rule(name)

# What a role the theme has never heard of looks like: nothing at all.
define nothing_rule(name: text) -> StyleRule:
    StyleRule{role_name: name, padding: 0, gap: 0, fg_colour: "", bg_colour: "", direction: "", radius: 0, size: 0, border: 0, border_colour: "", shadow: 0, shadow_colour: ""}
