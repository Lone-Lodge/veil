# web_demo - the whole gallery, in a browser.
#
# This is the honest test of the platform claim. The document is the SAME
# document the native app builds (veil_gallery), laid out by the SAME
# resolver, measured with the SAME font file. Nothing here knows about a
# window, a GPU or a DOM: it turns a DisplayList into JSON and serves it,
# and the browser turns that JSON into pixels.
#
# If the seam were incomplete - if it quietly dropped shadows, corners or
# clipping - this would render a visibly different program, which is
# exactly why it is worth having.
#
# The transport is plain HTTP on purpose. A websocket would be fewer
# round trips and not one line more convincing.
#
#   GET /              the page
#   GET /font.b64      the face the layout was measured with
#   GET /frame?...     the display list, as JSON
#
#   Run from this directory:  orbit run
#   Then open:                http://localhost:7800

use ori_geometry
use ori_display
use veil_document
use veil_theme
use veil_resolver
use veil_web
use veil_gallery
use veil_edit
use veil_measure
use typeface
use os
use net
use time
use text
use encoding

define view_w() -> number = 1040
define view_h() -> number = 720

define box() -> Rect:
    Rect{x: 0.0, y: 0.0, wide: to_real(view_w()), high: to_real(view_h())}

# Everything the gallery needs to draw itself. The native app carries the
# same fields; here only the few this demo actually moves are alive, and
# the rest are the values the app starts with.
# The gallery as the server starts it. After that it is whatever the last
# press made it - the SAME press chain the native app runs, so a browser and
# a window cannot answer differently.
define fresh_screen() -> Gallery:
    Gallery{win_w: view_w(), win_h: view_h(), seconds: 0.0, hover: "", focus: "", show_focus: false, tab: "kontroller", scroll: 0, chosen: 0, before: "Skriv något långt här", picked: "", after: "", typing: false, dialog: false, lit: false, menu: "", menu_x: 0, menu_y: 0, picked_item: "", open: "", drawer: false, zoom: 100, page: 0, dock_w: 260, dock_h: 120, dock_plan: "Utforskare|Sök/Konsol|Problem", dock_pick: "Utforskare|Konsol", dock_ws: "260", carrying: "", carry_x: 0, carry_y: 0, over: "", grabbed: "", moved: "", sort_by: "namn", sort_up: true, table_at: 0, contrast: false, bright: false, tip: "", notes: "", boxes: false, note: "Flera rader.", note_at: 0, note_to: 0, noting: false, slider: 35, volume: 70, sfx: 45, vsync: true, subs: false, quality: "Mellan", steps: 1, screen: "1920 x 1080", card: 0, slot: 0, bind: "", key_fwd: "W", key_jump: "Space"}

# The two things a frame changes that a press does not: what the pointer is
# over, and how far the page has been scrolled. Everything else the shared
# press chain owns.
# What is in the field, and where the caret and the mark sit in it.
define typed_into(g: Gallery, line: Edit) -> Gallery:
    Gallery{win_w: g.win_w, win_h: g.win_h, seconds: g.seconds, hover: g.hover, focus: g.focus, show_focus: g.show_focus, tab: g.tab, scroll: g.scroll, chosen: g.chosen, before: edit_left_of(line), picked: edit_selected(line), after: edit_right_of(line), typing: g.typing, dialog: g.dialog, lit: g.lit, menu: g.menu, menu_x: g.menu_x, menu_y: g.menu_y, picked_item: g.picked_item, open: g.open, drawer: g.drawer, zoom: g.zoom, page: g.page, dock_w: g.dock_w, dock_h: g.dock_h, dock_plan: g.dock_plan, dock_pick: g.dock_pick, dock_ws: g.dock_ws, carrying: g.carrying, carry_x: g.carry_x, carry_y: g.carry_y, over: g.over, grabbed: g.grabbed, moved: g.moved, sort_by: g.sort_by, sort_up: g.sort_up, table_at: g.table_at, contrast: g.contrast, bright: g.bright, tip: g.tip, notes: g.notes, boxes: g.boxes, note: g.note, note_at: g.note_at, note_to: g.note_to, noting: g.noting, slider: g.slider, volume: g.volume, sfx: g.sfx, vsync: g.vsync, subs: g.subs, quality: g.quality, steps: g.steps, screen: g.screen, card: g.card, slot: g.slot, bind: g.bind, key_fwd: g.key_fwd, key_jump: g.key_jump}

define after_at(whole: text, from: number) -> text:
    b = bytes_of(whole)
    n = bytes_count(b)
    cut = if from > n then n else from
    text_of(bytes_part(b, cut, n))

define looking(g: Gallery, hover: text, page: number, at_second: number) -> Gallery:
    Gallery{win_w: g.win_w, win_h: g.win_h, seconds: at_second, hover: hover, focus: g.focus, show_focus: g.show_focus, tab: g.tab, scroll: g.scroll, chosen: g.chosen, before: g.before, picked: g.picked, after: g.after, typing: g.typing, dialog: g.dialog, lit: g.lit, menu: g.menu, menu_x: g.menu_x, menu_y: g.menu_y, picked_item: g.picked_item, open: g.open, drawer: g.drawer, zoom: g.zoom, page: page, dock_w: g.dock_w, dock_h: g.dock_h, dock_plan: g.dock_plan, dock_pick: g.dock_pick, dock_ws: g.dock_ws, carrying: g.carrying, carry_x: g.carry_x, carry_y: g.carry_y, over: g.over, grabbed: g.grabbed, moved: g.moved, sort_by: g.sort_by, sort_up: g.sort_up, table_at: g.table_at, contrast: g.contrast, bright: g.bright, tip: g.tip, notes: g.notes, boxes: g.boxes, note: g.note, note_at: g.note_at, note_to: g.note_to, noting: g.noting, slider: g.slider, volume: g.volume, sfx: g.sfx, vsync: g.vsync, subs: g.subs, quality: g.quality, steps: g.steps, screen: g.screen, card: g.card, slot: g.slot, bind: g.bind, key_fwd: g.key_fwd, key_jump: g.key_jump}

# --- reading the request ----------------------------------------------------
# A GET line is "GET /frame?what=move&x=12&y=40 HTTP/1.1". Everything this
# server needs is in it, so nothing has to parse a body.

define first_line(req: text) -> text:
    ls = lines(req)
    if length(ls) is 0 then "" else ls[0]

define wanted_path(req: text) -> text:
    parts = split(first_line(req), " ")
    if length(parts) < 2 then "/" else parts[1]

# The value of one query field, "" when it is not there.
define field(path: text, key: text) -> text:
    q = split(path, "?")
    if length(q) < 2:
        return ""
    edit found = ""
    loop pair in split(q[1], "&"):
        kv = split(pair, "=")
        if length(kv) is 2 and kv[0] is key:
            found = kv[1]
    found

define number_of(t: text) -> number:
    b = bytes_of(t)
    n = bytes_count(b)
    edit acc = 0
    edit neg = false
    loop i in 0 until n:
        c = byte_at(b, i)
        if c is 45 and i is 0:
            neg = true
        if c >= 48 and c <= 57:
            acc = acc * 10 + (c - 48)
    if neg then 0 - acc else acc

define starts_with(t: text, head: text) -> truth:
    b = bytes_of(t)
    h = bytes_of(head)
    if bytes_count(h) > bytes_count(b):
        return false
    text_of(bytes_part(b, 0, bytes_count(h))) is head

define after(t: text, from: number) -> text:
    b = bytes_of(t)
    n = bytes_count(b)
    cut = if from > n then n else from
    text_of(bytes_part(b, cut, n))

define last_part(whole: text) -> text:
    parts = split(whole, ":")
    if length(parts) is 0 then whole else parts[length(parts) - 1]

# Which tab a name like "tab:docka" asks for, or -1 for none.
define tab_wanted(name: text) -> number:
    if not starts_with(name, "tab:"):
        return 0 - 1
    want = after(name, 4)
    edit found = 0 - 1
    edit i = 0
    loop t in tab_names():
        if t is want:
            found = i
        i = i + 1
    found

# The answer, on a connection that stays open.
#
# This is the whole of what "laggy on the web" was. The server answered in
# six milliseconds and the browser saw two hundred, because closing after
# every answer made it open a NEW TCP connection for every single frame -
# and on a local machine handing out and reclaiming a port that fast costs
# fifty to two hundred and fifty milliseconds of connect time. Six of
# render, two hundred and fifty of handshake.
#
# Keeping it open needs Content-Length: without it the only way a browser
# can know the body ended is the connection closing, which is exactly the
# thing being avoided.
# Access-Control-Allow-Origin: en editor som ager sin egen duk bor pa en
# ANNAN origin an spelet (dots pa 7374, spelet nagon annanstans). Utan
# huvudet ser den inte en enda ram. Det ar inget demon hittar pa - det ar
# ett krav pa varje bildserver som nagon annan an dess egen sida ska rita.
define reply(conn: number, kind: text, body: text):
    size = bytes_count(bytes_of(body))
    tcp_send(conn, "HTTP/1.1 200 OK\r\nContent-Type: {kind}\r\nContent-Length: {size}\r\nCache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\nConnection: keep-alive\r\n\r\n" + body)

define main() -> number:
    face = font_body()
    edit dress = gallery_theme()

    # The very font the layout was measured with, served by the same
    # process on its own path. It is the subset the resolver itself loads,
    # nine kilobytes, and the page builds a face out of it before it paints
    # anything - a painter drawing in a face nobody measured paints a
    # different program however right its rectangles are.
    font_b64 = base64_encode(bytes_of(embed "../../../../orion/orbs/typeface/assets/Inter-Regular.subset.ttf"))

    server = tcp_listen(7800)
    print_line("veil gallery, in a browser")
    print_line("  page: http://localhost:7800")

    edit now = fresh_screen()
    edit hover = ""
    edit at_page = 0
    edit began = monotonic_ms()
    # What the pointer has hold of, and what it was when it took hold. A
    # drag is nothing but a name plus how far the pointer has come since.
    edit held = ""
    edit grab_x = 0
    edit grab_y = 0
    edit grab_w = 0
    edit line = edit_new("Skriv något långt här")

    edit said_once = false
    # Connections that are open and may ask again. A browser keeps a
    # handful and reuses them, so this list stays small.
    edit live = []
    # The last layout, and what it was laid out for.
    # The frame before. Everything the next one can reuse hangs off it.
    edit was_frame = first_frame(SemanticDocument{root: 0, nodes: []}, dress, face, box())

    loop:
        # Accept with a deadline, not a block. A blocking accept parks the
        # whole server on the NEXT connection, so it can never come back to
        # a connection it already has and read the next request on it -
        # which is what keeping them open is for.
        #
        # The deadline also PACES the loop, so nothing else has to. A
        # sleep would not do: sleeping is a 15.6 ms tick on this machine
        # and it showed up as exactly that in the browser - eleven to
        # fourteen milliseconds to first byte for an answer that cost
        # nothing to produce. A wait on a socket is a real wait.
        fresh = tcp_accept_wait(server, 1)
        if fresh >= 0:
            live = append(live, fresh)
        edit still = []
        edit busy = false
        loop conn in live:
            # Nothing waiting on this one: leave it open and move on. A
            # blocking read here would park the whole server on whichever
            # connection happened to be quiet.
            if not readable_within(conn, 0):
                still = append(still, conn)
                continue
            req = tcp_recv(conn, 8192)
            if req is "":
                _gone = tcp_close(conn)
                continue
            busy = true
            still = append(still, conn)
            path = wanted_path(req)
            if starts_with(path, "/font.b64"):
                reply(conn, "text/plain", font_b64)
            else if starts_with(path, "/frame"):
                what = field(path, "what")
                mx = number_of(field(path, "x"))
                my = number_of(field(path, "y"))
                was_hover = hover
                was_page = at_page
                # The seconds a screen has been up: what everything that
                # moves is told from. Without a clock the cooldown never
                # cools and the drawer never slides.
                doc = gallery_doc(looking(now, hover, at_page, to_real(monotonic_ms() - began) / 1000.0))
                edit here = if said_once then next_frame(was_frame, doc, dress, face, box()) else first_frame(doc, dress, face, box())

                if what is "wheel":
                    step = if my > 0 then 80 else 0 - 80
                    want = at_page + step
                    at_page = if want < 0 then 0 else want
                if what is "move":
                    hover = pick_placed(doc, dress, here.placed, mx, my)
                if what is "down":
                    on = pick_placed(doc, dress, here.placed, mx, my)
                    hover = on
                    # The SAME press chain the native app runs.
                    now = pressed(now, on)
                    # The palette is a theme, so it is rebuilt when it
                    # changes - the roles are the same, only the values move.
                    if on is "bright" or on is "contrast":
                        dress = gallery_theme()
                    # A slider and a grip are things you take HOLD of, and
                    # where the pointer was is half of what a drag means.
                    if on is "slider" or on is "vol" or on is "sfx" or starts_with(on, "grip:"):
                        held = on
                        grab_x = mx
                        grab_y = my
                        grab_w = if on is "grip:y" then now.dock_h else width_of(now, number_in(after_at(on, 7)), false)
                    if on is "field":
                        line = edit_put(line, caret_at(line.content, 14, face, mx - to_whole(rect_of(doc, here.placed, "field").x) - 12))
                if what is "up":
                    held = ""
                # The pointer moved with the button still down. What that
                # MEANS is the orb's business; where it is, is ours.
                if what is "drag" and held is not "":
                    now = dragged(now, held, share_at(rect_of(doc, here.placed, held), mx), mx - grab_x, my - grab_y, grab_w)
                # A key belongs to whatever is being typed into. One handler
                # owns the twenty editing keys; copy, cut and paste are not
                # here because a clipboard is a platform.
                if what is "char" and now.typing:
                    line = edit_type(line, number_of(field(path, "code")))
                if what is "key" and now.typing:
                    line = edit_key(line, number_of(field(path, "code")), field(path, "ctrl") is "1", field(path, "shift") is "1", false)
                now = typed_into(now, line)
                moved_on = hover is not was_hover or at_page is not was_page or what is "down" or what is "drag" or what is "char" or what is "key" or what is "up"

                if what is "move" and said_once and not moved_on:
                    was_frame = here
                    reply(conn, "application/json", "\{\"same\":1\}")
                else:
                    if moved_on:
                        here = next_frame(here, gallery_doc(looking(now, hover, at_page, to_real(monotonic_ms() - began) / 1000.0)), dress, face, box())
                    was_frame = here
                    reply(conn, "application/json", display_list_json(here.list))
                    said_once = true
            else:
                # Read per request, not once at boot: editing the painter
                # and reloading the tab is the whole loop for working on it.
                reply(conn, "text/html; charset=utf-8", read_file("index.html"))
        live = still

    0
